function ProgrammePage() {
  // Vue Animatrice — Suivi programme global
  // Utilise le contexte AppContext (données partagées avec tout AppLayout)
  const {data} = useApp();

  if (!data) return (
    <div style={{padding:"60px",textAlign:"center",color:C.txtMuted}}>
      <Spinner size={28} color={C.green}/>
      <div style={{marginTop:12,fontSize:13}}>Chargement des données…</div>
    </div>
  );

  return <EnseignantsPage/>;
}

// const EP_SLOTS: défini globalement ligne ~4092
// constante définie globalement

// [DEDUPLIQUÉ] const ENS_COLORS = { mbassam:"#1a6b3c",boubam:"#c0392b",douniaroud:"#2980b9",hayatouh:"#16a085",aissatous:"#8e44ad",essambas:"#d35400",koffa:"#27ae60",mawiyak:"#e67e22",sadjot:"#2c3e50",sylvie:"#c8a951" };
// const getColor = id => ENS_COLORS[id] || "#1a6b3c"; — défini globalement
// getIni: défini globalement

// ═══════════════════════════════════════════════════
// PALETTE
// ═══════════════════════════════════════════════════
// const C: référence au bloc global ci-dessus

const STATUT_CONFIG = {
  attente:  { label:"En attente",  emoji:"⏳", color:C.orange,  bg:C.orangePale, border:C.orangeBorder },
  validee:  { label:"Validée",     emoji:"✅", color:C.green,   bg:C.greenPale,  border:C.greenBorder  },
  rejetee:  { label:"Rejetée",     emoji:"❌", color:C.red,     bg:C.redPale,    border:C.redBorder    },
  vide:     { label:"Non soumise", emoji:"○",  color:C.txtLight,bg:"#f8fafc",    border:C.border       },
};

// ═══════════════════════════════════════════════════
// COMPOSANTS UI
// ═══════════════════════════════════════════════════
// EpSpinner: utilise Spinner global

// (composant Ep dédupliqué)

// (composant Ep dédupliqué)

const StatutBadge = ({ statut }) => {
  const cfg = STATUT_CONFIG[statut] || STATUT_CONFIG.vide;
  return <Pill ch={`${cfg.emoji} ${cfg.label}`} color={cfg.color} bg={cfg.bg}/>;
};

// ═══════════════════════════════════════════════════
// CHARGEMENT INITIAL
// ═══════════════════════════════════════════════════
async function loadData() {
  const [epreuves, users, classes] = await Promise.all([
    sb.get("epreuves", ""),
    sb.get("utilisateurs", "?select=id,nom,role,classes"),
    sb.get("classes", "?select=code,effectif&order=code"),
  ]);
  const eps = (epreuves||[]).map(e => ({
    ...e,
    stockPath: e.stockpath || e.stockPath || "",
    commentaires: Array.isArray(e.commentaires) ? e.commentaires : [],
  }));
  const usersMap = {};
  (users||[]).forEach(u => { usersMap[u.id] = { ...u, classes:u.classes||[], col:getColor(u.id), ini:getIni(u.nom) }; });
  return { epreuves: eps, users: usersMap, classes: classes||[] };
}

// ═══════════════════════════════════════════════════
// GRILLE DE COUVERTURE (vue animateur)
// ═══════════════════════════════════════════════════
function GrilleCouverture({ classes, epreuves, onCardClick }) {
  return (
    <div style={{ display:"flex",flexDirection:"column",gap:18 }}>
      {classes.map(cl => {
        const eps = epreuves.filter(e => e.classe === cl.code);
        const nb = eps.filter(e => e.statut === "validee").length;
        const total = EP_SLOTS.length;
        return (
          <div key={cl.code} style={{ background:C.white,borderRadius:11,border:`1px solid ${C.border}`,overflow:"hidden" }}>
            {/* Header classe */}
            <div style={{ padding:"10px 14px",background:"#f8fafc",borderBottom:`1px solid ${C.border}`,display:"flex",alignItems:"center",justifyContent:"space-between" }}>
              <div>
                <span style={{ fontSize:13,fontWeight:800,color:C.txt }}>{cl.code}</span>
                <span style={{ fontSize:11,color:C.txtMuted,marginLeft:8 }}>{cl.effectif} élèves</span>
              </div>
              <div style={{ display:"flex",alignItems:"center",gap:8 }}>
                <div style={{ width:80,height:5,background:"#e2e8f0",borderRadius:3,overflow:"hidden" }}>
                  <div style={{ height:"100%",width:`${Math.round(nb/total*100)}%`,background:nb===total?C.green:nb>0?C.orange:C.border,borderRadius:3,transition:"width .5s" }}/>
                </div>
                <span style={{ fontSize:11,fontWeight:700,color:nb===total?C.green:C.txtMuted }}>{nb}/{total} validées</span>
              </div>
            </div>
            {/* Slots */}
            <div style={{ display:"grid",gridTemplateColumns:"repeat(6,1fr)",gap:0 }}>
              {EP_SLOTS.map((slot, i) => {
                const ep = eps.find(e => e.trim === slot.trim && e.num === slot.ep);
                const st = ep?.statut || "vide";
                const cfg = STATUT_CONFIG[st];
                return (
                  <div key={i} onClick={() => ep && onCardClick(ep)}
                    style={{ padding:"10px 8px",textAlign:"center",borderRight:i<5?`1px solid ${C.border}`:"none",borderLeft:"none",background:cfg.bg,cursor:ep?"pointer":"default",transition:"all .15s" }}
                    onMouseEnter={e=>{ if(ep) e.currentTarget.style.opacity=".8"; }}
                    onMouseLeave={e=>{ e.currentTarget.style.opacity="1"; }}>
                    <div style={{ fontSize:9,fontWeight:800,color:TRIM_COLORS[slot.trim],marginBottom:3,letterSpacing:".05em" }}>{slot.label}</div>
                    <div style={{ fontSize:18,lineHeight:1,marginBottom:2 }}>{cfg.emoji}</div>
                    <div style={{ fontSize:9,color:cfg.color,fontWeight:600 }}>{cfg.label}</div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
}

// ═══════════════════════════════════════════════════
// CARTE ÉPREUVE (animateur — avec actions)
// ═══════════════════════════════════════════════════
function EpreuveCard({ ep, users, onAction, isAdmin }) {
  const [comment, setComment] = useState("");
  const [sendingCom, setSendingCom] = useState(false);
  const [actioning, setActioning] = useState(null);
  const ens = users[ep.ens] || { nom: ep.ens, ini: "??", col: C.txtLight };
  const cfg = STATUT_CONFIG[ep.statut] || STATUT_CONFIG.vide;

  const handleAction = async (statut) => {
    setActioning(statut);
    await onAction(ep.id, statut, null);
    setActioning(null);
  };

  const handleComment = async () => {
    if (!comment.trim()) return;
    setSendingCom(true);
    await onAction(ep.id, null, comment.trim());
    setComment("");
    setSendingCom(false);
  };

  return (
    <div style={{ background:C.white,borderRadius:12,border:`1.5px solid ${cfg.border}`,overflow:"hidden",animation:"fadeUp .3s ease" }}>
      {/* Header */}
      <div style={{ padding:"14px 16px",background:cfg.bg,borderBottom:`1px solid ${cfg.border}`,display:"flex",alignItems:"flex-start",gap:12 }}>
        {/* Icône type */}
        <div style={{ width:42,height:42,borderRadius:10,background:ep.type==="pdf"?C.redPale:C.bluePale,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20,flexShrink:0 }}>
          {ep.type==="pdf"?"📕":"📘"}
        </div>
        {/* Infos */}
        <div style={{ flex:1,minWidth:0 }}>
          <div style={{ fontSize:14,fontWeight:800,color:C.txt }}>
            {ep.trim}·{ep.num} — {ep.classe} · SVTEEHB
          </div>
          <div style={{ display:"flex",flexWrap:"wrap",gap:10,marginTop:5 }}>
            <div style={{ display:"flex",alignItems:"center",gap:6 }}>
              <div style={{ width:20,height:20,borderRadius:"50%",background:ens.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:8,fontWeight:800,color:"#fff" }}>{ens.ini}</div>
              <span style={{ fontSize:12,color:C.txtMuted }}>{ens.nom}</span>
            </div>
            <span style={{ fontSize:12,color:C.txtMuted }}>📅 {ep.soumis}</span>
            {ep.fichier && <span style={{ fontSize:12,color:C.txtMuted }}>📄 {ep.fichier}</span>}
            {ep.taille && <span style={{ fontSize:12,color:C.txtMuted }}>{ep.taille}</span>}
          </div>
        </div>
        <StatutBadge statut={ep.statut}/>
      </div>

      {/* Actions animateur */}
      {isAdmin && ep.statut === "attente" && (
        <div style={{ padding:"12px 16px",display:"flex",gap:8,borderBottom:`1px solid ${C.border}`,background:"rgba(255,255,255,.7)" }}>
          <button onClick={() => handleAction("validee")} disabled={!!actioning}
            style={{ flex:1,padding:"9px",background:actioning==="validee"?C.green:`linear-gradient(135deg,${C.greenDark},${C.greenLight})`,color:"#fff",border:"none",borderRadius:9,fontSize:13,fontWeight:700,cursor:actioning?"not-allowed":"pointer",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:7 }}>
            {actioning==="validee" ? <><Spinner s={14}/>Validation…</> : "✓ Valider"}
          </button>
          <button onClick={() => handleAction("rejetee")} disabled={!!actioning}
            style={{ flex:1,padding:"9px",background:actioning==="rejetee"?C.red:C.redPale,color:actioning==="rejetee"?"#fff":C.red,border:`1.5px solid ${C.redBorder}`,borderRadius:9,fontSize:13,fontWeight:700,cursor:actioning?"not-allowed":"pointer",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:7 }}>
            {actioning==="rejetee" ? <><Spinner size={14} color={C.red}/>Rejet…</> : "✗ Rejeter"}
          </button>
          {ep.stockPath && (
            <button onClick={() => window.open(sb.fileUrl(ep.stockPath), "_blank")}
              style={{ padding:"9px 14px",background:"#f8fafc",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,fontWeight:600,cursor:"pointer",color:C.txtMuted,fontFamily:"inherit",whiteSpace:"nowrap" }}>
              👁️ Prévisualiser
            </button>
          )}
        </div>
      )}

      {/* Bouton prévisualisation seul (validée / rejetée) */}
      {isAdmin && ep.statut !== "attente" && ep.stockPath && (
        <div style={{ padding:"10px 16px",borderBottom:`1px solid ${C.border}` }}>
          <button onClick={() => window.open(sb.fileUrl(ep.stockPath), "_blank")}
            style={{ padding:"7px 14px",background:"#f8fafc",border:`1px solid ${C.border}`,borderRadius:8,fontSize:12,fontWeight:600,cursor:"pointer",color:C.txtMuted,fontFamily:"inherit" }}>
            👁️ Prévisualiser / Imprimer
          </button>
        </div>
      )}

      {/* Commentaires existants */}
      {ep.commentaires.length > 0 && (
        <div style={{ padding:"12px 16px",borderBottom:`1px solid ${C.border}`,display:"flex",flexDirection:"column",gap:8 }}>
          <div style={{ fontSize:11,fontWeight:700,color:C.txtMuted,textTransform:"uppercase",letterSpacing:".06em",marginBottom:2 }}>
            {isAdmin ? "Échanges" : "Retour de l'animatrice"}
          </div>
          {ep.commentaires.map((c, i) => (
            <div key={i} style={{ display:"flex",gap:9 }}>
              <div style={{ width:26,height:26,borderRadius:"50%",background:c.col||C.gold,display:"flex",alignItems:"center",justifyContent:"center",fontSize:9,fontWeight:800,color:"#fff",flexShrink:0 }}>
                {c.av}
              </div>
              <div style={{ flex:1,background:"#f8fafc",borderRadius:9,padding:"8px 11px",border:`1px solid ${C.border}` }}>
                <div style={{ display:"flex",justifyContent:"space-between",marginBottom:3 }}>
                  <span style={{ fontSize:11,fontWeight:700,color:C.txt }}>{c.aut}</span>
                  <span style={{ fontSize:10,color:C.txtLight }}>{c.date}</span>
                </div>
                <div style={{ fontSize:12,color:C.txtMuted,lineHeight:1.5 }}>{c.txt}</div>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Zone commentaire */}
      <div style={{ padding:"12px 16px",display:"flex",gap:8,alignItems:"flex-end" }}>
        <textarea value={comment} onChange={e=>setComment(e.target.value)}
          placeholder="Ajouter un commentaire…"
          rows={1} onInput={e=>{ e.target.style.height="auto"; e.target.style.height=e.target.scrollHeight+"px"; }}
          style={{ flex:1,padding:"9px 12px",border:`1px solid ${C.border}`,borderRadius:9,fontSize:12,color:C.txt,fontFamily:"inherit",resize:"none",outline:"none",lineHeight:1.4,background:"#f8fafc",transition:"border .2s" }}
          onFocus={e=>{ e.target.style.borderColor=C.green; e.target.style.background=C.white; }}
          onBlur={e=>{ e.target.style.borderColor=C.border; e.target.style.background="#f8fafc"; }}
          onKeyDown={e=>{ if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();handleComment();} }}/>
        <button onClick={handleComment} disabled={!comment.trim()||sendingCom}
          style={{ padding:"9px 14px",background:comment.trim()?C.green:"#e2e8f0",color:comment.trim()?"#fff":C.txtLight,border:"none",borderRadius:9,fontSize:13,fontWeight:700,cursor:comment.trim()?"pointer":"not-allowed",fontFamily:"inherit",flexShrink:0,display:"flex",alignItems:"center",gap:6 }}>
          {sendingCom ? <Spinner size={14}/> : "➤"}
        </button>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// FORMULAIRE DE SOUMISSION (enseignant)
// ═══════════════════════════════════════════════════
function FormSoumission({ user, onSubmit }) {
  const [file, setFile] = useState(null);
  const [classe, setClasse] = useState(user.classes?.[0] || "");
  const [trim, setTrim] = useState("T1");
  const [num, setNum] = useState("E1");
  const [note, setNote] = useState("");
  const [dragging, setDragging] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const fileRef = useRef();

  const handleFile = (f) => { if (f && f.size <= 10*1024*1024) setFile(f); };
  const handleDrop = (e) => { e.preventDefault(); setDragging(false); handleFile(e.dataTransfer.files[0]); };

  const submit = async () => {
    if (!file) return;
    setSubmitting(true);
    const id = "ep" + Date.now();
    const ext = file.name.split(".").pop().toLowerCase();
    const date = new Date().toLocaleDateString("fr-FR", { day:"2-digit", month:"2-digit", year:"numeric" });
    const stockPath = `${id}_${file.name.replace(/[^a-zA-Z0-9._-]/g,"_")}`;
    const commentaires = note ? [{ av:user.ini, col:user.col, aut:user.nom.split(" ")[0], txt:note, date:new Date().toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}) }] : [];
    // Upload Storage
    const uploaded = await sb.uploadFile(stockPath, file);
    const ep = { id, ens:user.id, classe, trim, num, fichier:file.name, stockpath:uploaded?stockPath:"", type:ext, taille:`${(file.size/1024).toFixed(0)} Ko`, soumis:date, statut:"attente", commentaires };
    const ok = await sb.upsert("epreuves", ep, "id");
    setSubmitting(false);
    if (ok) { setFile(null); setNote(""); onSubmit(ep, true); }
    else onSubmit(null, false);
  };

  // Slots disponibles selon trim
  const slots = EP_SLOTS.filter(s => s.trim === trim);

  return (
    <div style={{ background:C.white,borderRadius:12,border:`1px solid ${C.border}`,overflow:"hidden" }}>
      <div style={{ padding:"14px 16px",background:"#f8fafc",borderBottom:`1px solid ${C.border}` }}>
        <h3 style={{ margin:0,fontSize:14,fontWeight:700,color:C.txt }}>📤 Soumettre une épreuve</h3>
        <p style={{ margin:"3px 0 0",fontSize:12,color:C.txtMuted }}>L'animatrice sera notifiée automatiquement</p>
      </div>
      <div style={{ padding:"18px 16px",display:"flex",flexDirection:"column",gap:14 }}>
        {/* Sélecteurs */}
        <div style={{ display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:10 }}>
          <div>
            <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:4 }}>Classe</label>
            <select value={classe} onChange={e=>setClasse(e.target.value)}
              style={{ width:"100%",padding:"9px 11px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,background:C.white,fontFamily:"inherit",outline:"none",cursor:"pointer" }}>
              {(user.classes||[]).map(cl=><option key={cl} value={cl}>{cl}</option>)}
            </select>
          </div>
          <div>
            <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:4 }}>Trimestre</label>
            <select value={trim} onChange={e=>{ setTrim(e.target.value); setNum(EP_SLOTS.find(s=>s.trim===e.target.value)?.ep||"E1"); }}
              style={{ width:"100%",padding:"9px 11px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,background:C.white,fontFamily:"inherit",outline:"none",cursor:"pointer" }}>
              {["T1","T2","T3"].map(t=><option key={t} value={t}>{TRIM_LABELS[t]}</option>)}
            </select>
          </div>
          <div>
            <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:4 }}>Épreuve</label>
            <select value={num} onChange={e=>setNum(e.target.value)}
              style={{ width:"100%",padding:"9px 11px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,background:C.white,fontFamily:"inherit",outline:"none",cursor:"pointer" }}>
              {slots.map(s=><option key={s.ep} value={s.ep}>{s.label}</option>)}
            </select>
          </div>
        </div>

        {/* Zone upload */}
        {!file ? (
          <div
            onDragOver={e=>{ e.preventDefault(); setDragging(true); }}
            onDragLeave={()=>setDragging(false)}
            onDrop={handleDrop}
            onClick={()=>fileRef.current?.click()}
            style={{ border:`2px dashed ${dragging?C.green:C.border}`,borderRadius:11,padding:"28px 20px",textAlign:"center",cursor:"pointer",background:dragging?C.greenPale:"#f8fafc",transition:"all .2s" }}>
            <div style={{ fontSize:32,marginBottom:8 }}>📎</div>
            <div style={{ fontSize:13,fontWeight:700,color:C.txt }}>Déposer le fichier ici</div>
            <div style={{ fontSize:12,color:C.txtMuted,marginTop:3 }}>ou cliquer pour parcourir — PDF, Word, image — max 10 Mo</div>
            <input ref={fileRef} type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" style={{ display:"none" }} onChange={e=>handleFile(e.target.files[0])}/>
          </div>
        ) : (
          <div style={{ background:C.greenPale,border:`1.5px solid ${C.greenBorder}`,borderRadius:11,padding:"12px 14px",display:"flex",alignItems:"center",gap:12 }}>
            <div style={{ fontSize:22,flexShrink:0 }}>{file.name.endsWith(".pdf")?"📕":"📘"}</div>
            <div style={{ flex:1,minWidth:0 }}>
              <div style={{ fontSize:13,fontWeight:700,color:C.txt,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis" }}>{file.name}</div>
              <div style={{ fontSize:11,color:C.txtMuted }}>{(file.size/1024).toFixed(0)} Ko</div>
            </div>
            <button onClick={()=>setFile(null)} style={{ padding:"4px 9px",background:C.redPale,border:`1px solid ${C.redBorder}`,borderRadius:7,color:C.red,fontSize:11,fontWeight:700,cursor:"pointer",fontFamily:"inherit",flexShrink:0 }}>Changer</button>
          </div>
        )}

        {/* Note facultative */}
        <div>
          <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:4 }}>Note à l'animatrice (optionnel)</label>
          <textarea value={note} onChange={e=>setNote(e.target.value)} rows={2} placeholder="Informations complémentaires, consignes, contexte…"
            style={{ width:"100%",padding:"9px 12px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:12,color:C.txt,fontFamily:"inherit",resize:"vertical",outline:"none",background:"#f8fafc",transition:"border .2s" }}
            onFocus={e=>{ e.target.style.borderColor=C.green; e.target.style.background=C.white; }}
            onBlur={e=>{ e.target.style.borderColor=C.border; e.target.style.background="#f8fafc"; }}/>
        </div>

        {/* Bouton */}
        <button onClick={submit} disabled={!file||submitting}
          style={{ width:"100%",padding:"12px",background:file&&!submitting?`linear-gradient(135deg,${C.greenDark},${C.greenLight})`:"#e2e8f0",color:file&&!submitting?"#fff":C.txtLight,border:"none",borderRadius:10,fontSize:14,fontWeight:700,cursor:file&&!submitting?"pointer":"not-allowed",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:9 }}>
          {submitting ? <><Spinner/>Envoi en cours…</> : "📤 Soumettre à l'animatrice"}
        </button>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// VUE ANIMATEUR COMPLÈTE
// ═══════════════════════════════════════════════════
function EpViewAdmin({ data, setData, showToast }) {
  const [activeTab, setActiveTab] = useState("pending");
  const [selectedEp, setSelectedEp] = useState(null);
  const [filterEns, setFilterEns] = useState("all");

  const pending   = data?.epreuves||[].filter(e => e.statut === "attente");
  const validated = data?.epreuves||[].filter(e => e.statut === "validee");
  const rejected  = data?.epreuves||[].filter(e => e.statut === "rejetee");
  const enseignants = Object.values(data?.users||{}).filter(u => u.role !== "animatrice");

  const filtered = (list) => filterEns === "all" ? list : list.filter(e => e.ens === filterEns);

  const handleAction = useCallback(async (epId, statut, commentaire) => {
    const eps = [...data?.epreuves||[]];
    const ep  = eps.find(e => e.id === epId);
    if (!ep) return;

    if (statut) {
      ep.statut = statut;
      const ok = await sb.upsert("epreuves", { id:ep.id, statut }, "id");
      if (ok) {
        showToast(statut==="validee" ? "✅ Épreuve validée — enseignant notifié" : "⚠️ Épreuve rejetée — enseignant notifié", true);
      }
    }
    if (commentaire) {
      const now = new Date().toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"});
      ep.commentaires.push({ av:"AS", col:C.gold, aut:"Sylvie", txt:commentaire, date:now });
      await sb.upsert("epreuves", { id:ep.id, commentaires:ep.commentaires }, "id");
      showToast("💬 Commentaire envoyé", true);
    }
    setData(prev => ({ ...prev, epreuves: eps }));
    if (selectedEp?.id === epId) setSelectedEp(eps.find(e => e.id === epId));
  }, [data?.epreuves||[], selectedEp]);

  const tabs = [
    { id:"pending",   label:"En attente",  count:pending.length,   color:C.orange },
    { id:"validated", label:"Validées",     count:validated.length, color:C.green  },
    { id:"rejected",  label:"Rejetées",     count:rejected.length,  color:C.red    },
    { id:"grille",    label:"Grille globale",count:null,            color:C.blue   },
  ];

  const currentList = activeTab==="pending" ? filtered(pending) : activeTab==="validated" ? filtered(validated) : filtered(rejected);

  return (
    <div style={{ display:"grid",gridTemplateColumns:"1fr 380px",gap:16,alignItems:"start" }}>
      {/* Gauche — liste */}
      <div style={{ display:"flex",flexDirection:"column",gap:14 }}>
        {/* Stats */}
        <div style={{ display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10 }}>
          {[
            { label:"En attente", val:pending.length,   col:C.orange, bg:C.orangePale },
            { label:"Validées",   val:validated.length, col:C.green,  bg:C.greenPale  },
            { label:"Rejetées",   val:rejected.length,  col:C.red,    bg:C.redPale    },
            { label:"Total",      val:data?.epreuves||[].length, col:C.blue, bg:C.bluePale },
          ].map((s,i)=>(
            <div key={i} style={{ background:s.bg,borderRadius:10,border:`1px solid ${s.col}20`,padding:"12px 14px" }}>
              <div style={{ fontSize:10,color:s.col,fontWeight:700,marginBottom:4 }}>{s.label}</div>
              <div style={{ fontSize:28,fontWeight:900,color:s.col }}>{s.val}</div>
            </div>
          ))}
        </div>

        {/* Onglets */}
        <div style={{ display:"flex",gap:0,background:"#f8fafc",borderRadius:10,padding:4,border:`1px solid ${C.border}` }}>
          {tabs.map(t=>(
            <button key={t.id} onClick={()=>setActiveTab(t.id)}
              style={{ flex:1,padding:"7px 6px",borderRadius:7,border:"none",background:activeTab===t.id?C.white:"transparent",color:activeTab===t.id?C.txt:C.txtMuted,fontSize:11,fontWeight:700,cursor:"pointer",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:5,boxShadow:activeTab===t.id?"0 1px 4px rgba(0,0,0,.08)":"none",transition:"all .15s" }}>
              {t.label}
              {t.count !== null && <span style={{ minWidth:18,height:18,borderRadius:"50%",background:t.count>0?t.color:C.border,color:"#fff",fontSize:9,fontWeight:800,display:"flex",alignItems:"center",justifyContent:"center",padding:"0 4px" }}>{t.count}</span>}
            </button>
          ))}
        </div>

        {/* Filtre enseignant */}
        {activeTab !== "grille" && (
          <div style={{ display:"flex",alignItems:"center",gap:8 }}>
            <span style={{ fontSize:12,color:C.txtMuted,fontWeight:600,flexShrink:0 }}>Enseignant :</span>
            <select value={filterEns} onChange={e=>setFilterEns(e.target.value)}
              style={{ padding:"6px 10px",border:`1px solid ${C.border}`,borderRadius:8,fontSize:12,color:C.txt,background:C.white,fontFamily:"inherit",outline:"none",cursor:"pointer" }}>
              <option value="all">Tous les enseignants</option>
              {enseignants.map(u=><option key={u.id} value={u.id}>{u.nom}</option>)}
            </select>
          </div>
        )}

        {/* Contenu */}
        {activeTab === "grille" ? (
          <GrilleCouverture classes={data?.classes||[]} epreuves={data?.epreuves||[]} onCardClick={setSelectedEp}/>
        ) : (
          <div style={{ display:"flex",flexDirection:"column",gap:10 }}>
            {currentList.length === 0 ? (
              <div style={{ textAlign:"center",padding:"40px",color:C.txtMuted,background:C.white,borderRadius:12,border:`1px solid ${C.border}` }}>
                <div style={{ fontSize:32,marginBottom:8 }}>
                  {activeTab==="pending"?"📭":activeTab==="validated"?"✅":"📋"}
                </div>
                <div style={{ fontSize:13,fontWeight:600 }}>
                  {activeTab==="pending"?"Aucune épreuve en attente":activeTab==="validated"?"Aucune épreuve validée":"Aucune épreuve rejetée"}
                </div>
              </div>
            ) : (
              currentList.map(ep=>(
                <EpreuveCard key={ep.id} ep={ep} users={data?.users||{}} onAction={handleAction} isAdmin={true}/>
              ))
            )}
          </div>
        )}
      </div>

      {/* Droite — détail sélectionné */}
      <div style={{ position:"sticky",top:70 }}>
        {selectedEp ? (
          <div>
            <div style={{ display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:10 }}>
              <h3 style={{ margin:0,fontSize:13,fontWeight:700,color:C.txt }}>Détail de l'épreuve</h3>
              <button onClick={()=>setSelectedEp(null)} style={{ padding:"4px 9px",background:"#f8fafc",border:`1px solid ${C.border}`,borderRadius:7,color:C.txtMuted,fontSize:11,cursor:"pointer",fontFamily:"inherit" }}>✕ Fermer</button>
            </div>
            <EpreuveCard ep={data?.epreuves||[].find(e=>e.id===selectedEp.id)||selectedEp} users={data?.users||{}} onAction={handleAction} isAdmin={true}/>
          </div>
        ) : (
          <div style={{ background:C.white,borderRadius:12,border:`1px solid ${C.border}`,padding:"28px 20px",textAlign:"center",color:C.txtMuted }}>
            <div style={{ fontSize:32,marginBottom:10 }}>👆</div>
            <div style={{ fontSize:13,fontWeight:600,marginBottom:5 }}>Sélectionner une épreuve</div>
            <div style={{ fontSize:12 }}>Cliquez sur une carte de la grille ou d'une épreuve pour voir le détail et agir</div>
          </div>
        )}
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// VUE ENSEIGNANT COMPLÈTE
// ═══════════════════════════════════════════════════
function EpViewTeacher({ user, data, setData, showToast }) {
  const mesEpreuves = (data?.epreuves||[]).filter(e => e.ens_id === user.id || e.ens === user.id);
  const pending   = mesEpreuves.filter(e => e.statut === "attente");
  const validated = mesEpreuves.filter(e => e.statut === "validee");
  const rejected  = mesEpreuves.filter(e => e.statut === "rejetee");

  const handleAction = useCallback(async (epId, statut, commentaire) => {
    const eps = [...data?.epreuves||[]];
    const ep = eps.find(e => e.id === epId);
    if (!ep || !commentaire) return;
    const now = new Date().toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"});
    ep.commentaires.push({ av:user.ini, col:user.col, aut:user.nom.split(" ")[0], txt:commentaire, date:now });
    await sb.upsert("epreuves", { id:ep.id, commentaires:ep.commentaires }, "id");
    showToast("💬 Message envoyé à l'animatrice", true);
    setData(prev => ({ ...prev, epreuves: eps }));
  }, [data?.epreuves||[], user]);

  const onSubmit = (ep, ok) => {
    if (ok && ep) {
      setData(prev => ({ ...prev, epreuves: [ep, ...prev.epreuves] }));
      showToast("✅ Épreuve soumise — animatrice notifiée", true);
    } else {
      showToast("⚠️ Erreur lors de la soumission", false);
    }
  };

  return (
    <div style={{ display:"grid",gridTemplateColumns:"1fr 340px",gap:16,alignItems:"start" }}>
      {/* Gauche — mes épreuves */}
      <div style={{ display:"flex",flexDirection:"column",gap:14 }}>
        {/* Stats */}
        <div style={{ display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:10 }}>
          {[
            { label:"En attente",   val:pending.length,   col:C.orange, bg:C.orangePale },
            { label:"Validées",     val:validated.length, col:C.green,  bg:C.greenPale  },
            { label:"À corriger",   val:rejected.length,  col:C.red,    bg:C.redPale    },
          ].map((s,i)=>(
            <div key={i} style={{ background:s.bg,borderRadius:10,border:`1px solid ${s.col}20`,padding:"12px 14px" }}>
              <div style={{ fontSize:10,color:s.col,fontWeight:700,marginBottom:4 }}>{s.label}</div>
              <div style={{ fontSize:28,fontWeight:900,color:s.col }}>{s.val}</div>
            </div>
          ))}
        </div>

        <h3 style={{ margin:0,fontSize:14,fontWeight:700,color:C.txt }}>📋 Mes épreuves soumises</h3>

        {mesEpreuves.length === 0 ? (
          <div style={{ textAlign:"center",padding:"40px",color:C.txtMuted,background:C.white,borderRadius:12,border:`1px solid ${C.border}` }}>
            <div style={{ fontSize:32,marginBottom:8 }}>📭</div>
            <div style={{ fontSize:13,fontWeight:600 }}>Aucune épreuve soumise</div>
            <div style={{ fontSize:12,marginTop:4 }}>Utilisez le formulaire ci-contre pour soumettre votre première épreuve</div>
          </div>
        ) : (
          <div style={{ display:"flex",flexDirection:"column",gap:10 }}>
            {/* Rejetées en premier — action requise */}
            {rejected.length > 0 && (
              <div style={{ background:C.redPale,border:`1px solid ${C.redBorder}`,borderRadius:10,padding:"10px 14px",marginBottom:4 }}>
                <div style={{ fontSize:12,fontWeight:700,color:C.red }}>⚠️ {rejected.length} épreuve{rejected.length>1?"s":""} rejetée{rejected.length>1?"s":""} — action requise</div>
                <div style={{ fontSize:11,color:C.txtMuted,marginTop:2 }}>Consultez les commentaires et soumettez une version corrigée</div>
              </div>
            )}
            {mesEpreuves.map(ep => (
              <EpreuveCard key={ep.id} ep={ep} users={data?.users||{}} onAction={handleAction} isAdmin={false}/>
            ))}
          </div>
        )}
      </div>

      {/* Droite — formulaire */}
      <div style={{ position:"sticky",top:70 }}>
        <FormSoumission user={user} onSubmit={onSubmit}/>
        {/* Grille slots */}
        <div style={{ marginTop:14,background:C.white,borderRadius:12,border:`1px solid ${C.border}`,padding:"14px 16px" }}>
          <h4 style={{ margin:"0 0 12px",fontSize:13,fontWeight:700,color:C.txt }}>📊 Mes slots d'épreuves</h4>
          <div style={{ display:"grid",gridTemplateColumns:"repeat(2,1fr)",gap:7 }}>
            {EP_SLOTS.map((slot,i) => {
              const submitted = mesEpreuves.filter(e => e.trim===slot.trim && e.num===slot.ep);
              // On prend la plus récente
              const ep = submitted.sort((a,b)=>b.soumis?.localeCompare(a.soumis)||0)[0];
              const st = ep?.statut || "vide";
              const cfg = STATUT_CONFIG[st];
              return (
                <div key={i} style={{ padding:"8px 10px",borderRadius:9,border:`1.5px solid ${cfg.border}`,background:cfg.bg }}>
                  <div style={{ fontSize:9,fontWeight:800,color:TRIM_COLORS[slot.trim],marginBottom:3,letterSpacing:".05em" }}>{slot.label}</div>
                  <div style={{ display:"flex",alignItems:"center",gap:5 }}>
                    <span style={{ fontSize:14 }}>{cfg.emoji}</span>
                    <span style={{ fontSize:10,color:cfg.color,fontWeight:700 }}>{cfg.label}</span>
                  </div>
                  {ep?.classe && <div style={{ fontSize:9,color:C.txtLight,marginTop:2 }}>{ep.classe}</div>}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// PAGE PRINCIPALE
// ═══════════════════════════════════════════════════

function EpreuvesPage() {
  const {user, data, setData, showToast} = useApp();
  const isAdmin = user?.role === "animatrice";

  if (!data) return (
    <div style={{padding:"60px",textAlign:"center",color:C.txtMuted}}>
      <Spinner size={28} color={C.green}/>
      <div style={{marginTop:12,fontSize:13}}>Chargement…</div>
    </div>
  );

  if (isAdmin) return <EpViewAdmin data={data} setData={setData} showToast={showToast}/>;

  // Vue enseignant — utiliser l'utilisateur connecté
  const ens = user;
  return <EpViewTeacher user={ens} data={data} setData={setData} showToast={showToast}/>;
}


// ═══════════════════════════════════════════════════
// PALETTE
// ═══════════════════════════════════════════════════
// const C: référence au bloc global ci-dessus

// ═══════════════════════════════════════════════════
// CHARGEMENT DONNÉES
// ═══════════════════════════════════════════════════
// loadData: définie globalement (charge classes, users, prog_suivi, epreuves, edt_exceptions)

// progDocMeta: définie globalement dans le header

// ═══════════════════════════════════════════════════
// GÉNÉRATION HTML DOCUMENT OFFICIEL MINESEC
// ═══════════════════════════════════════════════════
function enteteOfficiel(titre, sousTitre) {
  return `
  <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;border-bottom:2px solid #1a6b3c;padding-bottom:10px">
    <div style="text-align:center;font-size:9px;line-height:1.5;width:45%">
      <div style="font-weight:bold">REPUBLIQUE DU CAMEROUN</div>
      <div style="font-style:italic">Paix – Travail – Patrie</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>MINISTERE DES ENSEIGNEMENTS SECONDAIRES</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>INSPECTION GENERALE DES ENSEIGNEMENTS</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>INSPECTION DE PEDAGOGIE CHARGEE DE L'ENSEIGNEMENT DES SCIENCES</div>
      <div style="font-size:7px">– – – – – –</div>
      <div style="font-weight:bold">SECTION : SVTEEHB</div>
    </div>
    <div style="text-align:center;width:10%;display:flex;flex-direction:column;align-items:center;gap:6px">
      <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#34b06c,#0c3d24);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:14px">SV</div>
    </div>
    <div style="text-align:center;font-size:9px;line-height:1.5;width:45%">
      <div style="font-weight:bold">REPUBLIC OF CAMEROON</div>
      <div style="font-style:italic">Peace – Work – Fatherland</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>MINISTRY OF SECONDARY EDUCATION</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>INSPECTORATE GENERAL OF EDUCATION</div>
      <div style="font-size:7px">– – – – – –</div>
      <div>INSPECTORATE OF PEDAGOGY IN CHARGE OF THE TEACHING OF SCIENCES</div>
      <div style="font-size:7px">– – – – – –</div>
      <div style="font-weight:bold">SECTION : LESEEHB</div>
    </div>
  </div>
  <h2 style="text-align:center;font-size:13px;font-weight:900;text-transform:uppercase;border:2px solid #222;padding:7px;margin:8px 0;letter-spacing:.04em">${titre}</h2>
  ${sousTitre ? `<p style="text-align:center;font-size:10px;color:#444;margin:0 0 8px">${sousTitre}</p>` : ""}
  <div style="text-align:left;font-size:9px;margin-bottom:2px">Établissement : Lycée de Kakatare &nbsp;|&nbsp; Discipline : SVTEEHB &nbsp;|&nbsp; Année scolaire : 2025-2026</div>`;
}

// Fiche de suivi pédagogique (vue animatrice par enseignant)
// ═══════════════════════════════════════════════════════════════════
// genFicheSuivi — Fiche de Suivi Pédagogique MINESEC officielle
// Source modèle : Modele_de_FP.pdf — MINESEC-DRES/EXTREME-NORD
// Structure : identique au modèle officiel — toutes colonnes présentes
// ═══════════════════════════════════════════════════════════════════
function genFicheSuivi(enseignant, classes, progIndex, trim = "ANN", notesIndex = {}) {
  const periode = TRIM_LABELS[trim] || "Année complète";
  const nbSem   = trim === "ANN" ? 36 : 12;
  const dateJour = new Date().toLocaleDateString("fr-FR",{day:"2-digit",month:"long",year:"numeric"});
  // Logo chargé depuis /logo.png — pas de base64 dans le bundle

  // ── Lignes du tableau ────────────────────────────────────────────
  const rows = classes.map(cl => {
    const eleves = ELEVES_DB[cl] || [];
    const g = eleves.filter(e=>e.g==="M").length;
    const f = eleves.filter(e=>e.g==="F").length;
    const total = eleves.length;

    const code = resolveProgCode(cl);
    const meta = code ? PROG_META[code] : null;
    if (!meta) return `<tr><td style="font-weight:700;border:1px solid #aaa;padding:3px 5px">${cl}</td><td colspan="25" style="border:1px solid #aaa;padding:3px;text-align:center;color:#999;font-style:italic">Programme non mappé</td></tr>`;

    const key    = `${enseignant.id}||${cl}`;
    const faites = progIndex[key] || [];
    const lf     = faites.length;

    let lp = meta.lpRef, tpP = meta.tp?.length||0;
    if (trim !== "ANN") {
      const range = code ? getTrimRange(code, trim) : null;
      if (range) {
        const lecons = LECONS_DATA[code]||[];
        lp  = lecons.filter(l=>l.n>=range[0]&&l.n<=range[1]).length || meta.lpRef;
        tpP = (meta.tp||[]).filter(n=>n>=range[0]&&n<=range[1]).length;
      }
    }
    const lfTrim = trim==="ANN" ? lf : faites.filter(n=>{ const r=getTrimRange(code,trim); return r&&n>=r[0]&&n<=r[1]; }).length;
    const tauxLP = lp>0 ? Math.round(lfTrim/lp*100) : 0;
    const tpFait = (meta.tp||[]).filter(n=>faites.includes(n)).length;
    const tpFT   = trim==="ANN" ? tpFait : (meta.tp||[]).filter(n=>{ const r=getTrimRange(code,trim); return faites.includes(n)&&r&&n>=r[0]&&n<=r[1]; }).length;
    const tauxTP = tpP>0 ? Math.round(tpFT/tpP*100) : 0;
    const hp     = meta.vh * nbSem;  // Heures dues = volume horaire hebdo × nombre de semaines
    const hfEns  = Math.round(lfTrim * (meta.hd/meta.lpRef));
    const tauxHD = meta.hd>0 ? Math.round(hfEns/meta.hd*100) : 0;

    // ── Taux de réussite depuis les MOYENNES TRIMESTRIELLES ──
    // Moy Séq = (Devoir + Compo)/2 · Moy Trim = (Séq1 + Séq2)/2
    // Moy Trim = (Eval1 + Eval2) / 2
    const getN = (eid, t, e) => {
      const v = (notesIndex[`${cl}||${t}-${e}`]||{})[eid];
      return (v===undefined||v===""||v===null) ? null : +v;
    };
    const moyTrimEl = (eid, t) => {
      const e1=getN(eid,t,"E1"), e2=getN(eid,t,"E2");
      if(e1===null&&e2===null) return null;
      if(e1!==null&&e2!==null) return (e1+e2)/2;
      return e1!==null?e1:e2;
    };
    const trimsToAvg = trim==="ANN" ? ["T1","T2","T3"] : [trim];
    const moyEleve = (eid) => {
      const ms = trimsToAvg.map(t=>moyTrimEl(eid,t)).filter(m=>m!==null);
      return ms.length>0 ? ms.reduce((s,m)=>s+m,0)/ms.length : null;
    };
    let moyennesAll=[], moyennesG=[], moyennesF=[];
    eleves.forEach(el=>{
      const m = moyEleve(el.id);
      if(m!==null){
        moyennesAll.push(m);
        if(el.g==="M") moyennesG.push(m); else moyennesF.push(m);
      }
    });
    const avg = a => a.length>0 ? a.reduce((s,n)=>s+n,0)/a.length : 0;
    const tauxReussite = moyennesAll.length>0 ? Math.round(moyennesAll.filter(n=>n>=10).length/moyennesAll.length*100) : null;
    const moyClasse = moyennesAll.length>0 ? avg(moyennesAll).toFixed(1) : null;
    const pctG = moyennesG.length>0 ? Math.round(moyennesG.filter(n=>n>=10).length/moyennesG.length*100) : null;
    const pctF = moyennesF.length>0 ? Math.round(moyennesF.filter(n=>n>=10).length/moyennesF.length*100) : null;
    const coeffMat = getCoeffMatiere(cl);

    const pct = (v) => {
      const col = v>=75?"#166534":v>=50?"#92400e":"#991b1b";
      return `color:${col};font-weight:700`;
    };
    const td = `border:1px solid #aaa;padding:3px 4px;text-align:center;font-size:7px`;

    return `<tr>
      <td style="border:1px solid #aaa;padding:3px 5px;font-weight:700;font-size:7px">${cl}</td>
      <td style="${td}">${g}</td><td style="${td}">${f}</td><td style="${td};font-weight:700">${total}</td>
      <td style="${td}">${hp}</td><td style="${td}">___</td><td style="${td}">___</td>
      <td style="${td}">${lp}</td><td style="${td};font-weight:700">${lfTrim}</td><td style="${td};${pct(tauxLP)}">${tauxLP}%</td>
      <td style="${td}">0</td><td style="${td}">0</td><td style="${td}">0%</td>
      <td style="${td}">${meta.hd}</td><td style="${td}">${hfEns}</td><td style="${td};${pct(tauxHD)}">${tauxHD}%</td>
      <td style="${td}">${tpP}</td><td style="${td};font-weight:700">${tpFT}</td><td style="${td};${pct(tauxTP)}">${tauxTP}%</td>
      <td style="${td}">${pctG!==null?pctG+"%":"___"}</td><td style="${td}">${pctF!==null?pctF+"%":"___"}</td><td style="${td};${tauxReussite!==null?pct(tauxReussite):""}" colspan="2">${tauxReussite!==null?tauxReussite+"%":"___"}</td>
      <td style="${td};font-weight:700">${moyClasse!==null?moyClasse:"___"}</td>
      <td style="${td};font-weight:700;color:#166534">${coeffMat}</td>
      <td style="${td};font-weight:700">${moyClasse!==null?(parseFloat(moyClasse)*coeffMat).toFixed(1):"___"}</td>
    </tr>`;
  }).join("");

  return `<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8">
<style>
  @page{size:A4 landscape;margin:8mm 10mm;}
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:"Times New Roman",Times,serif;font-size:8px;color:#000;background:#fff;width:277mm;}
  /* ── EN-TÊTE ── */
  .entete{display:grid;grid-template-columns:1fr 70px 1fr;gap:0 6px;align-items:start;padding-bottom:5px;border-bottom:2px solid #000;margin-bottom:4px;}
  .col-fr,.col-en{font-size:7px;line-height:1.6;text-align:center;}
  .pays{font-size:8.5px;font-weight:900;text-transform:uppercase;letter-spacing:.03em;}
  .devise{font-style:italic;font-size:7px;}
  .sep{font-size:6.5px;letter-spacing:3px;margin:1px 0;}
  .admin{font-size:6.8px;}
  .etab{font-weight:900;font-size:7.5px;border-top:1px solid #000;margin-top:3px;padding-top:2px;text-transform:uppercase;}
  .logo-zone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;}
  .logo-zone img{width:64px;height:64px;object-fit:contain;}
  .devise-etab{font-size:5.5px;font-style:italic;text-align:center;color:#444;letter-spacing:.02em;}
  /* ── TITRE ── */
  .titre-bloc{background:#d9d9d9;border:1px solid #aaa;text-align:center;padding:5px 10px 4px;margin-top:4px;line-height:1.4;}
  .titre-principal{font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;text-decoration:underline;}
  .titre-annee{font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-top:1px;}
  .titre-minesec{font-size:7.5px;font-style:italic;font-weight:700;letter-spacing:.05em;margin-top:1px;}
  /* ── PÉRIODE ── */
  .periode{display:flex;justify-content:center;gap:50px;font-size:8.5px;margin:3px 0 2px;font-family:Arial,sans-serif;}
  /* ── INFOS ── */
  .info-bloc{border:1px solid #000;border-top:none;padding:4px 8px;font-family:Arial,sans-serif;font-size:8px;}
  .info-row{display:flex;flex-wrap:wrap;gap:2px 8px;margin-bottom:2px;align-items:baseline;}
  .il{font-style:italic;white-space:nowrap;font-size:7.8px;}
  .iv{font-weight:700;border-bottom:1px solid #555;min-width:80px;font-size:8px;flex:1;max-width:240px;}
  .iv.long{max-width:360px;} .iv.s{max-width:70px;min-width:40px;}
  /* ── TABLEAU ── */
  .table-wrap{margin-top:3px;}
  table{width:100%;border-collapse:collapse;font-size:7px;font-family:Arial,sans-serif;table-layout:fixed;}
  th,td{border:1px solid #000;padding:1.5px 2px;text-align:center;vertical-align:middle;line-height:1.25;}
  .th1{font-size:6.8px;font-weight:700;} .th2{font-size:6.4px;font-weight:700;} .th3{font-size:6px;font-weight:700;background:#f0f0f0;}
  tbody tr:nth-child(even) td{background:#f9f9f9;}
  /* ── LÉGENDE ── */
  .legende{display:grid;grid-template-columns:1fr 1fr;border:1px solid #000;margin-top:4px;font-family:Arial,sans-serif;font-size:6.5px;line-height:1.7;}
  .leg-g{padding:4px 7px;border-right:1px solid #000;} .leg-d{padding:4px 7px;}
  .frac{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;font-size:6px;line-height:1.15;margin:0 2px;}
  .frac .num{border-bottom:1px solid #000;}
  /* ── OBS + SIGS ── */
  .obs{border:1px solid #000;border-top:none;padding:4px 8px;min-height:22px;font-family:Arial,sans-serif;font-size:7.5px;font-weight:700;font-style:italic;}
  .sigs{display:grid;grid-template-columns:1fr 1fr;gap:0 40px;margin-top:10px;font-family:Arial,sans-serif;font-size:8px;}
  .sig-t{font-weight:700;text-transform:uppercase;font-size:7.8px;}
  .sig-s{font-size:7px;font-style:italic;color:#444;margin-top:1px;}
  .sig-l{border-top:1px solid #000;margin-top:20px;padding-top:2px;font-size:7px;font-style:italic;color:#555;}
</style></head><body>

<!-- EN-TÊTE -->
<div class="entete">
  <div class="col-fr">
    <div class="pays">République du Cameroun</div>
    <div class="devise">Paix &ndash; Travail &ndash; Patrie</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Ministère des Enseignements Secondaires</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Inspection Générale des Enseignements</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Délégation Régionale de l'Extrême-Nord</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Délégation Départementale du Diamaré</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">MINESEC-DRES/EXTREME-NORD</div>
    <div class="etab">Lycée de Kakatare &mdash; Maroua</div>
  </div>
  <div class="logo-zone">
    <img src="/logo.png" alt="Logo Lycée de Kakatare"/>
    <div class="devise-etab">Discipline · Travail · Réussite</div>
  </div>
  <div class="col-en">
    <div class="pays">Republic of Cameroon</div>
    <div class="devise">Peace &ndash; Work &ndash; Fatherland</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Ministry of Secondary Education</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Inspectorate General of Education</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Far North Regional Delegation</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">Diamaré Departmental Delegation</div>
    <div class="sep">* * * * * * *</div>
    <div class="admin">MINESEC-DRES/FAR NORTH</div>
    <div class="etab">G.H.S. Kakatare &mdash; Maroua</div>
  </div>
</div>

<!-- TITRE -->
<div class="titre-bloc">
  <div class="titre-principal">Fiche de Suivi Pédagogique de l'Enseignant(e)</div>
  <div class="titre-annee">Année Scolaire : 2025 / 2026</div>
  <div class="titre-minesec">MINESEC / DRES / EXTRÊME-NORD</div>
</div>

<div class="periode">
  <span><em>PÉRIODE :</em>&nbsp;<strong>${periode}</strong></span>
  <span><em>Évaluation :</em>&nbsp;<strong>N° 1 · 2 · 3 · 4 · 5 · 6</strong></span>
</div>

<!-- INFOS ENSEIGNANT -->
<div class="info-bloc">
  <div class="info-row">
    <span class="il">ÉTABLISSEMENT :</span><span class="iv long">LYCÉE DE KAKATARE — MAROUA</span>
    <span class="il" style="margin-left:10px">DISCIPLINE :</span><span class="iv" style="max-width:90px">SVTEEHB</span>
    <span class="il" style="margin-left:8px">SECTION :</span><span class="iv s">ESG</span>
  </div>
  <div class="info-row">
    <span class="il">Nom de l'Enseignant(e) :</span><span class="iv long">${enseignant.nom}</span>
    <span class="il" style="margin-left:10px">Grade :</span><span class="iv s">PLEG</span>
    <span class="il" style="margin-left:8px">Ancienneté :</span><span class="iv s">___</span>
    <span class="il" style="margin-left:8px">Qualité :</span><span class="iv" style="max-width:110px">Fonctionnaire</span>
  </div>
  <div class="info-row">
    <span class="il">Heures hebdomadaires effectuées :</span>
    <span class="iv long">${classes.map((cl,i)=>`${cl} → ${(PROG_META[resolveProgCode(cl)]?.vh||"?")}h`).join(" | ")}</span>
    <span class="il" style="margin-left:10px">Animateur(trice) Pédagogique :</span>
    <span class="iv long">AÏSSATOU SYLVIE — PCEG</span>
  </div>
</div>

<!-- TABLEAU -->
<div class="table-wrap">
<table>
  <colgroup>
    <col style="width:54px">
    <col style="width:17px"><col style="width:17px"><col style="width:17px">
    <col style="width:23px"><col style="width:19px"><col style="width:19px">
    <col style="width:19px"><col style="width:19px"><col style="width:19px">
    <col style="width:19px"><col style="width:19px"><col style="width:19px">
    <col style="width:21px"><col style="width:21px"><col style="width:21px">
    <col style="width:21px"><col style="width:19px"><col style="width:19px">
    <col style="width:17px"><col style="width:17px"><col style="width:19px">
    <col style="width:24px">
  </colgroup>
  <thead>
    <tr>
      <th class="th1" rowspan="3">Classes<br>tenues</th>
      <th class="th1" colspan="3">Effectifs<br>des élèves</th>
      <th class="th1" colspan="3">Assiduité des élèves&nbsp;<sup>(2)</sup></th>
      <th class="th1" colspan="6">Couverture des programmes / référentiels de formation (par rapport à l'année)</th>
      <th class="th1" colspan="3">Couverture des heures<br>d'enseignement / année</th>
      <th class="th1" colspan="3">Taux d'exécution&nbsp;<sup>(3)</sup> des TP/TD/DOSSIERS</th>
      <th class="th1" colspan="4">Taux de réussite&nbsp;<sup>(4)</sup><br>(M ≥ 10)</th>
      <th class="th1" rowspan="3" style="font-size:6px">Moy.<br>Gén.<br>Cl.<sup>(5)</sup><br>/20</th>
      <th class="th1" rowspan="3" style="font-size:6px">Coeff<br>SVT<sup>(6)</sup></th>
      <th class="th1" rowspan="3" style="font-size:6px">Total<br>points<br>(M×C)</th>
    </tr>
    <tr>
      <th class="th2">G</th><th class="th2">F</th><th class="th2">T</th>
      <th class="th2" colspan="2">Heures</th><th class="th2">Taux<br>(%)</th>
      <th class="th2" colspan="3">En présentiel</th>
      <th class="th2" colspan="3" style="font-size:6.2px">Ressources<br>digitalisées</th>
      <th class="th2">H.<br>Dues</th><th class="th2">H.<br>Faites</th><th class="th2">Taux<br>(%)</th>
      <th class="th2">Nbre<br>Prév.</th><th class="th2">Nbre<br>fait</th><th class="th2">Taux<br>(%)</th>
      <th class="th2">%<br>Garc</th><th class="th2">%<br>Filles</th><th class="th2" colspan="2">Total</th>
    </tr>
    <tr>
      <th class="th3"></th><th class="th3"></th><th class="th3"></th>
      <th class="th3" style="font-size:5.8px">Prévues</th><th class="th3" style="font-size:5.8px">Faites</th><th class="th3"></th>
      <th class="th3" style="font-size:5.8px">L.P.</th><th class="th3" style="font-size:5.8px">L.F.</th><th class="th3" style="font-size:5.8px">Taux<br>(%)</th>
      <th class="th3" style="font-size:5.8px">L.P.</th><th class="th3" style="font-size:5.8px">L.F.</th><th class="th3" style="font-size:5.8px">Taux<br>(%)</th>
      <th class="th3"></th><th class="th3"></th><th class="th3"></th>
      <th class="th3"></th><th class="th3"></th><th class="th3"></th>
      <th class="th3"></th><th class="th3"></th><th class="th3" colspan="2"></th>
    </tr>
  </thead>
  <tbody>${rows}</tbody>
</table>
</div>

<!-- LÉGENDE -->
<div class="legende">
  <div class="leg-g">
    <strong>(1)</strong> Rayer la mention inutile.<br>
    <strong>(2)</strong> Calcul du Taux d'Assiduité : TA = <span class="frac"><span class="num">(A &minus; B) &times; 100</span><span>A</span></span><br>
    A = (Vol. Hor. Hebdo. × Effectif) ; B = absences enregistrées<br>
    <em>NB : Ce Taux peut se calculer sur le trimestre (12 sem.)</em>
  </div>
  <div class="leg-d">
    <strong>(3)</strong> Taux TD/TP = <span class="frac"><span class="num">(Nbre fait) &times; 100</span><span>Nbre prévu</span></span>&nbsp;&nbsp;
    <strong>(4)</strong> Taux réussite = <span class="frac"><span class="num">(M &ge; 10 par genre) &times; 100</span><span>Effectif évalué</span></span><br><br>
    <strong>(5)</strong> Moy. Gén. = <span class="frac"><span class="num">Somme des Notes</span><span>Nombre élèves évalués</span></span>
  &nbsp;&nbsp;<strong>(6)</strong> Coeff SVTEEHB selon série (officiel MINESEC) · Total points = Moyenne &times; Coefficient
  </div>
</div>

<div class="obs">
  Observations générales (difficultés rencontrées + suggestions pour améliorer les résultats) :
  <br><br>&nbsp;&nbsp;&nbsp;.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.
</div>

<div class="sigs">
  <div>
    <div class="sig-t">Visa de l'Animateur(trice) Pédagogique</div>
    <div class="sig-s">AÏSSATOU SYLVIE — PCEG</div>
    <div class="sig-l">Signature &amp; Cachet</div>
  </div>
  <div style="text-align:right">
    <div class="sig-t">Fait à Maroua, le &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ${dateJour.split(" ").slice(-1)[0]}</div>
    <div class="sig-s">Signature de l'Enseignant(e) — ${enseignant.nom}</div>
    <div class="sig-l">Signature</div>
  </div>
</div>

<script>window.onload=()=>{window.print();}</script>
</body></html>`;
}




// Fiche de compilation par niveau
function genCompilation(data, trim = "ANN") {
  const periode = TRIM_LABELS[trim] || "Année complète";
  const niveaux = {};
  data?.classes||[].forEach(cl => {
    const g = niveauGroupe(cl.code);
    if (!niveaux[g]) niveaux[g] = [];
    niveaux[g].push(cl);
  });

  let sections = "";
  Object.entries(niveaux).forEach(([niv, cls]) => {
    const rows = cls.map(cl => {
      const md = progDocMeta(cl.code, trim, (data?.prog||{}), null);
      const ens = Object.values(data?.users||{}).find(u =>
        (u.classes||[]).includes(cl.code)
      );
      return `
      <tr>
        <td style="text-align:left;font-weight:700;padding:5px 8px;border:1px solid #ccc">${cl.code}</td>
        <td style="text-align:center;padding:5px 8px;border:1px solid #ccc">${cl.effectif||"—"}</td>
        <td style="text-align:left;padding:5px 8px;border:1px solid #ccc">${ens?.nom||"—"}</td>
        <td style="text-align:center;padding:5px 8px;border:1px solid #ccc">${md?.vh??"—"}h</td>
        <td style="text-align:center;padding:5px 8px;border:1px solid #ccc">${md?.lpRef??"—"}</td>
        <td style="text-align:center;padding:5px 8px;border:1px solid #ccc">${md?.lfRef??"—"}</td>
        <td style="text-align:center;padding:5px 8px;border:1px solid #ccc;font-weight:700;color:${md&&md.taux>=75?'#16a34a':md&&md.taux>=50?'#e67e22':'#ef4444'}">${md?md.taux+"%":"—"}</td>
      </tr>`;
    }).join("");
    sections += `
    <h3 style="font-size:11px;font-weight:bold;margin:14px 0 4px;padding:5px 10px;background:#1a6b3c;color:#fff">${niv}</h3>
    <table>
      <thead><tr>
        <th>CLASSE</th><th>Effectif</th><th>Enseignant</th>
        <th>V.H.<br>hebdo</th><th>Leçons<br>prévues</th>
        <th>Leçons<br>faites</th><th>Taux de<br>couverture</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  });

  return `<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8">
<style>
  body { font-family: Arial, sans-serif; font-size: 10px; margin: 20px; color: #111; }
  table { width: 100%; border-collapse: collapse; margin-top: 4px; }
  thead tr { background: #1a6b3c; color: #fff; }
  th { padding: 6px 8px; border: 1px solid #999; text-align: center; font-size: 9px; }
  tr:nth-child(even) { background: #f0fdf4; }
  @media print { body { margin: 10px; } }
</style>
</head>
<body>
  ${enteteOfficiel("FICHE DE COMPILATION PAR NIVEAU", `Département SVTEEHB &nbsp;|&nbsp; ${periode}`)}
  ${sections}
  <div style="margin-top:20px;display:grid;grid-template-columns:1fr 1fr;gap:30px;font-size:9px">
    <div><div style="font-weight:bold;margin-bottom:10px">L'Animateur(trice) Pédagogique</div><div style="border-top:1px solid #999;margin-top:30px;padding-top:4px">Signature &amp; Cachet</div></div>
    <div><div style="font-weight:bold;margin-bottom:10px">Le Proviseur</div><div style="border-top:1px solid #999;margin-top:30px;padding-top:4px">Signature &amp; Cachet</div></div>
  </div>
  <script>window.onload=()=>window.print();</script>
</body>
</html>`;
}

// ═══════════════════════════════════════════════════
// IMPRESSION VIA IFRAME CACHÉ (méthode anti popup-blocker)
// ═══════════════════════════════════════════════════
// printGuard: déclaré globalement
function imprimerHTML(html) {
  if (printGuard) return;
  printGuard = true;
  const iframe = document.createElement("iframe");
  iframe.style.cssText = "position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;";
  document.body.appendChild(iframe);
  const doc = iframe.contentDocument || iframe.contentWindow.document;
  doc.open(); doc.write(html); doc.close();
  setTimeout(() => {
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
    setTimeout(() => { document.body.removeChild(iframe); printGuard = false; }, 2000);
  }, 400);
}

// ═══════════════════════════════════════════════════
// COMPOSANTS UI
// ═══════════════════════════════════════════════════
const DocSp = ({ size=20, color=C.green }) => (
  <div style={{ width:size,height:size,border:`2px solid ${color}30`,borderTopColor:color,borderRadius:"50%",animation:"spin .7s linear infinite" }}/>
);

const DocSk = ({ h=16, w="100%", br=6 }) => (
  <div style={{ height:h,width:w,borderRadius:br,background:"linear-gradient(90deg,#e2e8f0 25%,#f1f5f9 50%,#e2e8f0 75%)",backgroundSize:"200% 100%",animation:"shimmer 1.4s infinite" }}/>
);

const DocPi = ({ ch, color=C.green }) => (
  <span style={{ display:"inline-flex",alignItems:"center",padding:"2px 8px",borderRadius:20,fontSize:10,fontWeight:700,background:color+"18",color,whiteSpace:"nowrap" }}>{ch}</span>
);

const DocTaux = ({ taux }) => {
  const color = taux >= 75 ? C.green : taux >= 50 ? C.orange : C.red;
  return <DocPi ch={`${taux}%`} color={color}/>;
};

// ═══════════════════════════════════════════════════
// TABLEAU DE PRÉVISUALISATION
// ═══════════════════════════════════════════════════
function TabPreview({ data, trim, filterEns }) {
  const rows = [];
  Object.values(data?.users||{})
    .filter(u => u.role !== "animatrice")
    .filter(u => filterEns === "all" || u.id === filterEns)
    .forEach(ens => {
      (ens.classes||[]).forEach(cl => {
        const md = progDocMeta(cl, trim, (data?.prog||{}), null);
        const ef = data?.classes||[].find(c => c.code === cl)?.effectif || 0;
        rows.push({ ens, cl, ef, md });
      });
    });

  if (!rows.length) return (
    <div style={{ textAlign:"center",padding:40,color:C.txtMuted }}>
      <div style={{ fontSize:28,marginBottom:8 }}>📭</div>
      <div style={{ fontSize:13 }}>Aucune donnée disponible</div>
    </div>
  );

  return (
    <div style={{ overflowX:"auto" }}>
      <table style={{ width:"100%",borderCollapse:"collapse",fontSize:12 }}>
        <thead>
          <tr style={{ background:"#0c3d24",color:"#fff" }}>
            {["Enseignant","Classe","Effectif","V.H.","H.D.","L.Prévues","L.Faites","Taux"].map((h,i) => (
              <th key={i} style={{ padding:"9px 12px",textAlign:i>1?"center":"left",fontSize:10,fontWeight:700,letterSpacing:".05em",whiteSpace:"nowrap" }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr key={i} style={{ borderBottom:`1px solid ${C.border}`,background:i%2===0?C.white:"#f8fafc" }}>
              <td style={{ padding:"9px 12px" }}>
                <div style={{ display:"flex",alignItems:"center",gap:8 }}>
                  <div style={{ width:22,height:22,borderRadius:"50%",background:r.ens.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:8,fontWeight:800,color:"#fff",flexShrink:0 }}>{r.ens.ini}</div>
                  <span style={{ fontSize:11,fontWeight:600,color:C.txt }}>{r.ens.nom}</span>
                </div>
              </td>
              <td style={{ padding:"9px 12px",fontWeight:700,color:C.txt }}>{r.cl}</td>
              <td style={{ padding:"9px 12px",textAlign:"center",color:C.txtMuted }}>{r.ef}</td>
              <td style={{ padding:"9px 12px",textAlign:"center",color:C.txtMuted }}>{r.md?.vh??"—"}h/sem</td>
              <td style={{ padding:"9px 12px",textAlign:"center",color:C.txtMuted }}>{r.md?.hd??"—"}h</td>
              <td style={{ padding:"9px 12px",textAlign:"center",fontWeight:700,color:C.txt }}>{r.md?.lpRef??"—"}</td>
              <td style={{ padding:"9px 12px",textAlign:"center",fontWeight:700,color:C.green }}>{r.md?.lfRef??"—"}</td>
              <td style={{ padding:"9px 12px",textAlign:"center" }}>
                {r.md ? <DocTaux taux={r.md.taux}/> : <span style={{ color:C.txtLight }}>—</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// CARTE DOCUMENT
// ═══════════════════════════════════════════════════
function DocCard({ title, desc, emoji, color, onPrint, badge }) {
  const [printing, setPrinting] = useState(false);
  const handle = async () => {
    setPrinting(true);
    await new Promise(r => setTimeout(r, 100));
    onPrint();
    setTimeout(() => setPrinting(false), 600);
  };
  return (
    <div style={{ background:C.white,borderRadius:12,border:`1.5px solid ${color}30`,padding:"18px 20px",display:"flex",flexDirection:"column",gap:12 }}>
      <div style={{ display:"flex",alignItems:"flex-start",gap:12 }}>
        <div style={{ width:44,height:44,borderRadius:10,background:color+"18",display:"flex",alignItems:"center",justifyContent:"center",fontSize:22,flexShrink:0 }}>{emoji}</div>
        <div style={{ flex:1 }}>
          <div style={{ fontSize:14,fontWeight:800,color:C.txt,marginBottom:3 }}>{title}</div>
          <div style={{ fontSize:11,color:C.txtMuted,lineHeight:1.5 }}>{desc}</div>
          {badge && <div style={{ marginTop:6 }}><DocPi ch={badge} color={color}/></div>}
        </div>
      </div>
      <button onClick={handle} disabled={printing}
        style={{ padding:"10px",background:printing?"#e2e8f0":`linear-gradient(135deg,${C.greenDark},${C.greenLight})`,color:printing?C.txtMuted:"#fff",border:"none",borderRadius:9,fontSize:13,fontWeight:700,cursor:printing?"not-allowed":"pointer",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:8 }}>
        {printing ? <><DocSp size={14}/> Génération…</> : "🖨️ Générer et imprimer"}
      </button>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// PAGE PRINCIPALE
// ═══════════════════════════════════════════════════

function DocumentsPage() {
  const [data, setData]         = useState(null);
  const [loading, setLoading]   = useState(true);
  const [trim, setTrim]         = useState("ANN");
  const [selEns, setSelEns]     = useState("all");
  const [previewHtml, setPreviewHtml] = useState(null);  // HTML de l'aperçu
  const [previewLabel, setPreviewLabel] = useState("");
  const iframeRef = useRef(null);

  useEffect(() => {
    loadData().then(d => {
      setData(d);
      setLoading(false);
    });
  }, []);

  const enseignants = data ? Object.values(data?.users||{}).filter(u => u.role !== "animatrice") : [];

  // ── Aperçu dans iframe ────────────────────────────────────────────
  function afficherApercu(html, label) {
    setPreviewHtml(html);
    setPreviewLabel(label);
    // Injecter dans l'iframe après le render
    setTimeout(() => {
      if (iframeRef.current) {
        const doc = iframeRef.current.contentDocument || iframeRef.current.contentWindow.document;
        // Retirer le script d'impression auto pour l'aperçu
        const htmlSansScript = html.replace(/<script>window\.onload.*?<\/script>/gs, "");
        doc.open(); doc.write(htmlSansScript); doc.close();
      }
    }, 50);
  }

  function aperçuFicheEns(ensId) {
    if (!data) return;
    const ens = data?.users||{}[ensId];
    if (!ens) return;
    const html = genFicheSuivi(ens, ens.classes||[], (data?.prog||{}), trim, (data?.notes||{}));
    afficherApercu(html, `Fiche — ${ens.nom} — ${TRIM_LABELS[trim]||"Année"}`);
  }

  function aperçuCompilation() {
    if (!data) return;
    const html = genCompilation(data, trim);
    afficherApercu(html, `Compilation globale — ${TRIM_LABELS[trim]||"Année"}`);
  }

  // ── Impression ────────────────────────────────────────────────────
  function imprimerApercu() {
    if (!previewHtml) return;
    imprimerHTML(previewHtml);
  }

  function imprimerFicheEns(ensId) {
    if (!data) return;
    const ens = data?.users||{}[ensId];
    if (!ens) return;
    imprimerHTML(genFicheSuivi(ens, ens.classes||[], (data?.prog||{}), trim, (data?.notes||{})));
  }

  function imprimerToutesFiches() {
    if (!data) return;
    enseignants.forEach((ens, i) => {
      setTimeout(() => {
        imprimerHTML(genFicheSuivi(ens, ens.classes||[], (data?.prog||{}), trim, (data?.notes||{})));
      }, i * 2200);
    });
  }

  return (
    <div style={{ fontFamily:"'DM Sans',system-ui,sans-serif", minHeight:"100vh", background:C.bg }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
        *{box-sizing:border-box;margin:0;padding:0;}
        input,button,select{font-family:inherit;}
        ::-webkit-scrollbar{width:4px;height:4px;}
        ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px;}
      `}</style>

      {/* ── Topbar ──────────────────────────────────────────────────── */}
      <header style={{ height:52, background:"rgba(255,255,255,.94)", backdropFilter:"blur(12px)", borderBottom:`1px solid ${C.border}`, display:"flex", alignItems:"center", gap:12, padding:"0 20px", position:"sticky", top:0, zIndex:30 }}>
        <div style={{ width:28, height:28, borderRadius:"50%", background:C.sidebar, display:"flex", alignItems:"center", justifyContent:"center" }}>
          <span style={{ color:"#22c55e", fontSize:12, fontWeight:800 }}>SV</span>
        </div>
        <h1 style={{ fontSize:14, fontWeight:700, color:C.txt }}>📄 Documents officiels MINESEC</h1>
        <div style={{ flex:1 }}/>

        {/* Période */}
        <div style={{ display:"flex", gap:8, alignItems:"center" }}>
          <span style={{ fontSize:11, color:C.txtMuted }}>Période :</span>
          <select value={trim} onChange={e=>setTrim(e.target.value)}
            style={{ padding:"5px 10px", border:`1px solid ${C.border}`, borderRadius:8, fontSize:12, color:C.txt, background:C.white }}>
            <option value="ANN">Année complète</option>
            <option value="T1">Trimestre 1</option>
            <option value="T2">Trimestre 2</option>
            <option value="T3">Trimestre 3</option>
          </select>

          {/* Aperçu si présent : bouton imprimer */}
          {previewHtml && (
            <button onClick={imprimerApercu}
              style={{ padding:"6px 14px", background:`linear-gradient(135deg,${C.greenDark},${C.green})`, color:"#fff", border:"none", borderRadius:8, fontSize:12, fontWeight:700, cursor:"pointer", display:"flex", alignItems:"center", gap:6 }}>
              🖨️ Imprimer ce document
            </button>
          )}
        </div>
      </header>

      {/* ── Layout 2 colonnes ────────────────────────────────────────── */}
      <div style={{ display:"flex", flex:1 }}>

        {/* ── Panneau gauche — sélection ─────────────────────────────── */}
        <aside style={{ width:280, minWidth:280, borderRight:`1px solid ${C.border}`, overflowY:"auto", padding:16, display:"flex", flexDirection:"column", gap:12, background:C.white }}>

          <h2 style={{ fontSize:13, fontWeight:700, color:C.txt }}>📋 Choisir un document</h2>

          {loading ? (
            <div style={{ textAlign:"center", padding:30, color:C.txtMuted }}>
              <Spinner size={20} color={C.green}/>
              <div style={{ marginTop:8, fontSize:12 }}>Chargement…</div>
            </div>
          ) : (
            <>
              {/* ── Compilation globale ─────────────────── */}
              <div style={{ background:C.greenPale, border:`1.5px solid ${C.greenBorder}`, borderRadius:10, padding:"12px 14px" }}>
                <div style={{ fontSize:13, fontWeight:800, color:C.green, marginBottom:4 }}>📊 Compilation globale</div>
                <div style={{ fontSize:11, color:C.txtMuted, marginBottom:10, lineHeight:1.5 }}>
                  Toutes les classes · Tous les enseignants · Par niveau
                </div>
                <div style={{ display:"flex", gap:8 }}>
                  <button onClick={aperçuCompilation}
                    style={{ flex:1, padding:"7px", background:C.white, border:`1px solid ${C.greenBorder}`, borderRadius:8, fontSize:11, fontWeight:700, cursor:"pointer", color:C.green }}>
                    👁 Aperçu
                  </button>
                  <button onClick={()=>imprimerHTML(genCompilation(data,trim))}
                    style={{ flex:1, padding:"7px", background:C.green, border:"none", borderRadius:8, fontSize:11, fontWeight:700, cursor:"pointer", color:"#fff" }}>
                    🖨️ Imprimer
                  </button>
                </div>
              </div>

              {/* ── Fiches individuelles ────────────────── */}
              <div style={{ background:C.bluePale, border:`1.5px solid ${C.blue}30`, borderRadius:10, padding:"12px 14px" }}>
                <div style={{ fontSize:13, fontWeight:800, color:C.blue, marginBottom:4 }}>👨‍🏫 Fiches individuelles</div>
                <div style={{ fontSize:11, color:C.txtMuted, marginBottom:10 }}>
                  Sélectionner un enseignant pour aperçu ou impression directe
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                  {enseignants.map(ens => (
                    <div key={ens.id} style={{ display:"flex", alignItems:"center", gap:8, padding:"7px 10px", background:previewLabel.includes(ens.nom)?C.greenPale:C.white, border:`1px solid ${previewLabel.includes(ens.nom)?C.greenBorder:C.border}`, borderRadius:8, transition:"all .15s" }}>
                      <div style={{ width:22, height:22, borderRadius:"50%", background:ens.col, display:"flex", alignItems:"center", justifyContent:"center", fontSize:8, fontWeight:800, color:"#fff", flexShrink:0 }}>
                        {ens.ini}
                      </div>
                      <span style={{ flex:1, fontSize:11, fontWeight:600, color:C.txt, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>
                        {ens.nom}
                      </span>
                      <span style={{ fontSize:9, color:C.txtMuted, flexShrink:0 }}>
                        {(ens.classes||[]).length}cl
                      </span>
                      <button onClick={() => aperçuFicheEns(ens.id)}
                        style={{ padding:"3px 8px", background:C.greenPale, border:`1px solid ${C.greenBorder}`, borderRadius:6, fontSize:10, fontWeight:700, cursor:"pointer", color:C.green, flexShrink:0 }}>
                        👁
                      </button>
                      <button onClick={() => imprimerFicheEns(ens.id)}
                        style={{ padding:"3px 8px", background:C.green, border:"none", borderRadius:6, fontSize:10, fontWeight:700, cursor:"pointer", color:"#fff", flexShrink:0 }}>
                        🖨️
                      </button>
                    </div>
                  ))}
                </div>
                <button onClick={imprimerToutesFiches}
                  style={{ marginTop:10, width:"100%", padding:"8px", background:`linear-gradient(135deg,${C.greenDark},${C.green})`, color:"#fff", border:"none", borderRadius:8, fontSize:11, fontWeight:700, cursor:"pointer" }}>
                  🖨️ Imprimer toutes les fiches
                </button>
              </div>

              {/* Note */}
              <div style={{ background:C.goldPale, border:`1px solid ${C.gold}40`, borderRadius:8, padding:"10px 12px", fontSize:10, color:C.txtMuted, lineHeight:1.6 }}>
                ℹ️ L'aperçu s'affiche à droite. Cliquez <strong>👁 Aperçu</strong> pour visualiser avant d'imprimer.
              </div>
            </>
          )}
        </aside>

        {/* ── Panneau droit — aperçu iframe ──────────────────────────── */}
        <main style={{ flex:1, display:"flex", flexDirection:"column", overflow:"hidden" }}>

          {/* Header aperçu */}
          <div style={{ padding:"10px 20px", borderBottom:`1px solid ${C.border}`, display:"flex", alignItems:"center", gap:12, flexShrink:0, background:C.white }}>
            <div style={{ flex:1 }}>
              <h3 style={{ margin:0, fontSize:13, fontWeight:700, color:C.txt }}>
                {previewHtml ? `📄 ${previewLabel}` : "📄 Aperçu du document"}
              </h3>
              <p style={{ margin:"2px 0 0", fontSize:11, color:C.txtMuted }}>
                {previewHtml
                  ? "Cliquez 🖨️ dans la topbar pour imprimer ce document"
                  : "Sélectionnez un document dans le panneau gauche"}
              </p>
            </div>
            {previewHtml && (
              <div style={{ display:"flex", gap:8 }}>
                <button onClick={imprimerApercu}
                  style={{ padding:"6px 14px", background:`linear-gradient(135deg,${C.greenDark},${C.green})`, color:"#fff", border:"none", borderRadius:8, fontSize:12, fontWeight:700, cursor:"pointer" }}>
                  🖨️ Imprimer
                </button>
                <button onClick={()=>{ setPreviewHtml(null); setPreviewLabel(""); }}
                  style={{ padding:"6px 12px", background:C.white, border:`1px solid ${C.border}`, borderRadius:8, fontSize:11, color:C.txtMuted, cursor:"pointer" }}>
                  ✕ Fermer
                </button>
              </div>
            )}
          </div>

          {/* Zone iframe */}
          <div style={{ flex:1, overflow:"hidden", background:"#e5e7eb", padding:previewHtml?16:0, display:"flex", alignItems:"center", justifyContent:"center" }}>
            {previewHtml ? (
              <iframe
                ref={iframeRef}
                title="Aperçu document MINESEC"
                style={{
                  width:"100%", height:"100%",
                  border:"none", borderRadius:8,
                  background:"#fff",
                  boxShadow:"0 4px 24px rgba(0,0,0,.15)",
                }}
              />
            ) : (
              <div style={{ textAlign:"center", color:C.txtLight }}>
                <div style={{ fontSize:56, marginBottom:16 }}>📄</div>
                <div style={{ fontSize:15, fontWeight:700, color:C.txt, marginBottom:8 }}>
                  Aucun aperçu sélectionné
                </div>
                <div style={{ fontSize:12, color:C.txtMuted, maxWidth:320 }}>
                  Cliquez sur <strong>👁 Aperçu</strong> à côté d'un document pour le visualiser ici avant de l'imprimer.
                </div>
              </div>
            )}
          </div>
        </main>
      </div>
    </div>
  );
}

// getNowInfo: définie globalement

// ═══════════════════════════════════════════════════
// PALETTE
// ═══════════════════════════════════════════════════
// const C: référence au bloc global ci-dessus

// ═══════════════════════════════════════════════════
// COMPOSANTS UI
// ═══════════════════════════════════════════════════
const EdtSp = ({ size=18, color=C.green }) => (
  <span style={{ width:size,height:size,border:`2px solid ${color}30`,borderTopColor:color,borderRadius:"50%",display:"inline-block",animation:"spin .7s linear infinite",flexShrink:0 }}/>
);

const EdtSk = ({ h=16, w="100%", br=6 }) => (
  <div style={{ height:h,width:w,borderRadius:br,background:"linear-gradient(90deg,#e2e8f0 25%,#f1f5f9 50%,#e2e8f0 75%)",backgroundSize:"200% 100%",animation:"shimmer 1.4s infinite" }}/>
);

const EdtToast = ({ msg, ok }) => (
  <div style={{ position:"fixed",bottom:24,right:24,zIndex:9999,display:"flex",alignItems:"center",gap:10,padding:"12px 18px",borderRadius:12,background:ok===false?C.red:C.greenDark,color:"#fff",fontSize:13,fontWeight:600,boxShadow:"0 8px 24px rgba(0,0,0,.25)",animation:"fadeUp .3s ease" }}>
    {msg}
  </div>
);

// ═══════════════════════════════════════════════════
// CHARGEMENT DONNÉES
// ═══════════════════════════════════════════════════
// loadData (EDT): définie globalement — chargement simplifié

// getClassColor, classColorCache, colorIdx: définis globalement

// ═══════════════════════════════════════════════════
// WIDGET EN TEMPS RÉEL — qui fait quoi maintenant ?
// ═══════════════════════════════════════════════════
function NowWidget({ data }) {
  const [now, setNow] = useState(getNowInfo());
  const [time, setTime] = useState(new Date());

  useEffect(() => {
    const t = setInterval(() => { setNow(getNowInfo()); setTime(new Date()); }, 30000);
    return () => clearInterval(t);
  }, []);

  const enseignants = Object.values(data?.users||{}).filter(u => u.role !== "animatrice");

  return (
    <div style={{ background:C.white,borderRadius:12,border:`1px solid ${C.border}`,overflow:"hidden",marginBottom:16 }}>
      {/* Header */}
      <div style={{ padding:"12px 16px",background:"#0f1f14",display:"flex",alignItems:"center",justifyContent:"space-between" }}>
        <div style={{ display:"flex",alignItems:"center",gap:10 }}>
          <div style={{ width:8,height:8,borderRadius:"50%",background:C.greenLight,boxShadow:"0 0 8px rgba(34,197,94,.6)" }}/>
          <span style={{ fontSize:13,fontWeight:700,color:"#fff" }}>Activité en temps réel</span>
        </div>
        <div style={{ display:"flex",alignItems:"center",gap:8 }}>
          <span style={{ fontSize:12,color:"rgba(255,255,255,.5)" }}>
            {now.isWeekend ? "Week-end" : (now.jk ? JOURS[JKEYS.indexOf(now.jk)] : "—")}
          </span>
          <span style={{ fontSize:14,fontWeight:800,color:"#fff",fontVariantNumeric:"tabular-nums" }}>
            {time.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"})}
          </span>
          {now.hi >= 0 && !now.isWeekend && (
            <div style={{ padding:"2px 8px",background:C.greenLight+"22",border:`1px solid ${C.greenBorder}`,borderRadius:20,fontSize:10,fontWeight:700,color:C.greenLight }}>
              {HEURES[now.hi]}
            </div>
          )}
        </div>
      </div>

      {/* Grille enseignants */}
      <div style={{ display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:0 }}>
        {enseignants.map((ens, i) => {
          const edtBase = EDT_REEL[ens.id] || {};
          const exc = (data?.exceptions||{}[ens.id]||{})[now.jk+"-"+now.hi];
          const cl = now.jk && now.hi>=0 ? edtBase[now.jk]?.[now.hi] : null;
          const affiche = exc || cl;
          const enCours = !!affiche && !now.isWeekend && now.hi>=0;
          const isExc = !!exc;

          return (
            <div key={ens.id} style={{
              padding:"10px 12px",
              borderRight:i%3!==2?`1px solid ${C.border}`:"none",
              borderBottom:`1px solid ${C.border}`,
              background:enCours?(isExc?C.amberPale:C.greenPale):"transparent",
              transition:"background .3s",
            }}>
              <div style={{ display:"flex",alignItems:"center",gap:8,marginBottom:4 }}>
                <div style={{ width:24,height:24,borderRadius:"50%",background:ens.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:8,fontWeight:800,color:"#fff",flexShrink:0 }}>
                  {ens.ini}
                </div>
                <span style={{ fontSize:11,fontWeight:700,color:C.txt,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis" }}>
                  {ens.nom.split(" ").slice(0,2).join(" ")}
                </span>
                {enCours && <div style={{ width:6,height:6,borderRadius:"50%",background:isExc?C.amber:C.green,flexShrink:0 }}/>}
              </div>
              <div style={{ fontSize:10,fontWeight:enCours?700:400,color:enCours?(isExc?C.amber:C.green):C.txtLight,lineHeight:1.3 }}>
                {now.isWeekend ? "Week-end" :
                 now.hi<0 ? "Hors plage horaire" :
                 enCours ? (isExc?"⚡ "+affiche:"📚 "+affiche) :
                 "Libre"}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// GRILLE EDT D'UN ENSEIGNANT
// ═══════════════════════════════════════════════════
function EdtGrid({ ensId, ens, exceptions, isAdmin, onException }) {
  const edtBase = EDT_REEL[ensId] || {};
  const nowInfo = getNowInfo();

  return (
    <div style={{ overflowX:"auto" }}>
      <table style={{ width:"100%",borderCollapse:"collapse",minWidth:500 }}>
        <thead>
          <tr>
            <th style={{ padding:"8px 10px",background:"#0f1f14",color:"rgba(255,255,255,.7)",fontSize:10,fontWeight:700,textAlign:"center",borderRight:`1px solid rgba(255,255,255,.1)`,width:90 }}>Heure</th>
            {JOURS.map((j,ji) => {
              const isToday = !nowInfo.isWeekend && JKEYS[ji] === nowInfo.jk;
              return (
                <th key={j} style={{ padding:"8px 10px",background:isToday?"#1a3d24":"#0f1f14",color:isToday?"#4ade80":"rgba(255,255,255,.7)",fontSize:11,fontWeight:700,textAlign:"center",borderRight:ji<4?`1px solid rgba(255,255,255,.1)`:"none",transition:"background .3s" }}>
                  {j.slice(0,3)}
                  {isToday && <div style={{ fontSize:8,color:"#4ade80",fontWeight:600,marginTop:1 }}>Aujourd'hui</div>}
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {HEURES.map((heure, hi) => {
            const isCurrentSlot = !nowInfo.isWeekend && nowInfo.hi === hi;
            return (
              <tr key={hi} style={{ background:isCurrentSlot?"rgba(22,163,74,.04)":"transparent" }}>
                {/* Heure */}
                <td style={{ padding:"6px 8px",fontSize:9,color:isCurrentSlot?C.green:C.txtLight,fontWeight:isCurrentSlot?700:400,textAlign:"center",borderRight:`1px solid ${C.border}`,borderBottom:`1px solid ${C.border}`,whiteSpace:"nowrap",background:isCurrentSlot?"rgba(22,163,74,.06)":"#fafafa" }}>
                  {heure.split("-").join("\n–\n").replace("\n–\n","\n")}
                  {isCurrentSlot && <div style={{ fontSize:8,color:C.green,marginTop:1 }}>▶ En cours</div>}
                </td>
                {/* Cases */}
                {JKEYS.map((jk, ji) => {
                  const excKey = `${jk}-${hi}`;
                  const exc = (exceptions[ensId]||{})[excKey];
                  const cl = edtBase[jk]?.[hi];
                  const isNow = isCurrentSlot && jk === nowInfo.jk;
                  const isToday = !nowInfo.isWeekend && jk === nowInfo.jk;
                  const affiche = exc || cl;
                  const isExc = !!exc;

                  let bg = "transparent";
                  let borderColor = C.border;
                  let textColor = C.txtLight;
                  let fontWeight = 400;

                  if (isNow && affiche) { bg = isExc?"rgba(245,158,11,.12)":"rgba(22,163,74,.12)"; borderColor = isExc?C.amber:C.green; }
                  else if (isToday) { bg = "rgba(22,163,74,.03)"; }
                  if (affiche) { textColor = isExc?C.amber:getClassColor(cl); fontWeight = 600; }

                  return (
                    <td key={jk}
                      onClick={() => isAdmin && onException(ensId, jk, hi, cl, exc)}
                      style={{
                        padding:"5px 6px",
                        borderRight:ji<4?`1px solid ${C.border}`:"none",
                        borderBottom:`1px solid ${C.border}`,
                        background:bg,
                        cursor:isAdmin?"pointer":"default",
                        transition:"background .15s",
                        minWidth:80,
                        verticalAlign:"middle",
                      }}
                      onMouseEnter={e=>{ if(isAdmin) e.currentTarget.style.background=isExc?"rgba(245,158,11,.1)":"rgba(22,163,74,.08)"; }}
                      onMouseLeave={e=>{ e.currentTarget.style.background=bg; }}
                      title={isAdmin?"Cliquer pour modifier":undefined}
                    >
                      {affiche ? (
                        <div>
                          <div style={{ fontSize:10,fontWeight,color:textColor,lineHeight:1.3,textAlign:"center" }}>
                            {isExc && <span style={{ fontSize:8,display:"block",color:C.amber,marginBottom:1 }}>⚡ Réajusté</span>}
                            {affiche}
                          </div>
                          {isNow && (
                            <div style={{ fontSize:7,color:C.green,textAlign:"center",marginTop:2,fontWeight:700 }}>▶ EN COURS</div>
                          )}
                        </div>
                      ) : (
                        <div style={{ textAlign:"center",color:C.border,fontSize:10 }}>—</div>
                      )}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// MODAL RÉAJUSTEMENT EDT (animatrice uniquement)
// ═══════════════════════════════════════════════════
function ModalReajust({ ensId, jk, hi, cl, exc, users, onConfirm, onClose, saving }) {
  const [newEnsId, setNewEnsId] = useState(ensId);
  const [lbl, setLbl] = useState(exc || cl || "");
  const jour = JOURS[JKEYS.indexOf(jk)] || jk;
  const heure = HEURES[hi] || `Plage ${hi+1}`;
  const enseignants = Object.values(users).filter(u => u.role !== "animatrice");

  return (
    <div style={{ position:"fixed",inset:0,background:"rgba(0,0,0,.5)",zIndex:9000,display:"flex",alignItems:"center",justifyContent:"center",padding:20 }} onClick={e=>e.target===e.currentTarget&&onClose()}>
      <div style={{ background:C.white,borderRadius:16,padding:24,maxWidth:420,width:"100%",boxShadow:"0 20px 60px rgba(0,0,0,.3)",animation:"fadeUp .25s ease" }}>
        <div style={{ fontSize:16,fontWeight:800,color:C.txt,marginBottom:4 }}>📅 Réajustement EDT</div>
        <div style={{ fontSize:12,color:C.txtMuted,marginBottom:16 }}>{jour} · {heure}</div>

        {exc && (
          <div style={{ background:C.amberPale,border:`1px solid ${C.amber}30`,borderRadius:9,padding:"8px 12px",marginBottom:14,fontSize:11,color:C.amber,fontWeight:600 }}>
            ⚡ Exception actuelle : {exc}
          </div>
        )}
        {cl && !exc && (
          <div style={{ background:C.greenPale,border:`1px solid ${C.greenBorder}`,borderRadius:9,padding:"8px 12px",marginBottom:14,fontSize:11,color:C.green,fontWeight:600 }}>
            📚 Cours actuel : {cl}
          </div>
        )}
        {!cl && !exc && (
          <div style={{ background:"#f8fafc",border:`1px solid ${C.border}`,borderRadius:9,padding:"8px 12px",marginBottom:14,fontSize:11,color:C.txtMuted }}>
            Créneau actuellement libre
          </div>
        )}

        {/* Sélecteur enseignant */}
        <div style={{ marginBottom:14 }}>
          <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:5 }}>Réaffecter à</label>
          <select value={newEnsId} onChange={e=>setNewEnsId(e.target.value)}
            style={{ width:"100%",padding:"9px 11px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,fontFamily:"inherit",outline:"none",cursor:"pointer" }}>
            {enseignants.map(u=>(
              <option key={u.id} value={u.id}>{u.nom}</option>
            ))}
          </select>
        </div>

        {/* Libellé */}
        <div style={{ marginBottom:6 }}>
          <label style={{ display:"block",fontSize:10,fontWeight:700,letterSpacing:".07em",textTransform:"uppercase",color:C.txtMuted,marginBottom:5 }}>Libellé du créneau</label>
          <input value={lbl} onChange={e=>setLbl(e.target.value)} placeholder="Ex: 4ème 2 (remplacement)"
            style={{ width:"100%",padding:"9px 12px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,fontFamily:"inherit",outline:"none",background:"#f8fafc" }}
            onFocus={e=>{ e.target.style.borderColor=C.green; e.target.style.background=C.white; }}
            onBlur={e=>{ e.target.style.borderColor=C.border; e.target.style.background="#f8fafc"; }}/>
          <p style={{ fontSize:10,color:C.txtLight,marginTop:4 }}>Laisser vide pour supprimer l'exception</p>
        </div>

        <div style={{ display:"flex",gap:9,marginTop:18 }}>
          <button onClick={()=>onConfirm(ensId, newEnsId, jk, hi, lbl.trim())} disabled={saving}
            style={{ flex:1,padding:"11px",background:saving?"#e2e8f0":`linear-gradient(135deg,${C.greenDark},${C.greenLight})`,color:saving?C.txtMuted:"#fff",border:"none",borderRadius:9,fontSize:13,fontWeight:700,cursor:saving?"not-allowed":"pointer",fontFamily:"inherit",display:"flex",alignItems:"center",justifyContent:"center",gap:7 }}>
            {saving?<><EdtSp size={14}/>Sauvegarde…</>:"✓ Confirmer"}
          </button>
          <button onClick={onClose} style={{ padding:"11px 18px",background:C.redPale,border:`1px solid ${C.redBorder}`,borderRadius:9,fontSize:13,fontWeight:700,cursor:"pointer",color:C.red,fontFamily:"inherit" }}>
            Annuler
          </button>
        </div>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════
// PAGE PRINCIPALE
// ═══════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════
// EDT ANIMATRICE — Vue complète emploi du temps
// 3 onglets : Maintenant · Par enseignant · Par classe
// Connecté au contexte useApp() — données partagées, pas de rechargement
// ══════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════
// LOGIQUE DE CASCADE EDT — Modifications animatrice → répercussion temps réel
// ══════════════════════════════════════════════════════════════════════
//
// ARCHITECTURE :
//   EDT_REEL      = base codée en dur (programme Lantiv de départ)
//   edtRuntime    = état React global dans AppContext — copie modifiable d'EDT_REEL
//   edt_exceptions = table Supabase — persiste les modifications
//
// QUAND L'ANIMATRICE MODIFIE UN CRÉNEAU :
//   1. edtRuntime mis à jour → toutes les vues EDT se rafraîchissent
//   2. ENS_CLASSES_REF[ens.id] recalculé → les classes de l'enseignant changent
//   3. user.classes mis à jour dans AppContext → MonProgramme, MesClasses se rafraîchissent
//   4. Sauvegarde Supabase edt_exceptions (persistance)
//   5. Sauvegarde Supabase utilisateurs.classes (persistance)
// ══════════════════════════════════════════════════════════════════════

// ── Initialisation edtRuntime depuis EDT_REEL ─────────────────────────
function buildEdtRuntime(exceptions = {}) {
  // Copie profonde d'EDT_REEL + application des exceptions Supabase
  const rt = {};
  for (const ensId in EDT_REEL) {
    rt[ensId] = {};
    for (const jk in EDT_REEL[ensId]) {
      rt[ensId][jk] = [...(EDT_REEL[ensId][jk] || [])];
    }
  }
  // Appliquer les exceptions
  for (const ensId in exceptions) {
    for (const slot in exceptions[ensId]) {
      const [jk, hiStr] = slot.split('-');
      const hi = parseInt(hiStr);
      if (!rt[ensId]) rt[ensId] = {};
      if (!rt[ensId][jk]) rt[ensId][jk] = [];
      rt[ensId][jk][hi] = exceptions[ensId][slot] || null;
    }
  }
  return rt;
}

// ── Recalcule les classes d'un enseignant depuis l'edtRuntime ─────────
function getClassesFromEdt(ensId, edtRt) {
  const edt = edtRt[ensId] || {};
  const classes = new Set();
  Object.values(edt).forEach(jour => {
    (jour || []).forEach(cl => { if (cl) classes.add(cl); });
  });
  return [...classes].sort();
}

// ══════════════════════════════════════════════════════════════════════
// EdtPage AVEC CASCADE — Remplace la version précédente
// ══════════════════════════════════════════════════════════════════════
function EdtPage() {
  const {data, setData, user, setUser, showToast} = useApp();
  const [onglet,   setOnglet]   = useState("maintenant");
  const [selEns, setSelEns] = useState(()=> Object.keys(EDT_REEL)[0]||null);
  const [selCl, setSelCl] = useState(()=> { const allCl=[...new Set(Object.values(EDT_REEL).flatMap(e=>Object.values(e).flat().filter(Boolean)))].sort(); return allCl[0]||null; });
  const [modal,    setModal]    = useState(null); // {ensId, jk, hi, valActuelle}
  const [saving,   setSaving]   = useState(false);

  // ── edtRuntime : copie modifiable de l'EDT, état React ──────────────
  const [edtRt, setEdtRt] = useState(()=> buildEdtRuntime(data?.exceptions||{}));

  // Resynchroniser si data change (ex: rechargement)
  useEffect(()=>{
    setEdtRt(buildEdtRuntime(data?.exceptions||{}));
  }, [data?.exceptions]);

  const {jk: nowJk, hi: nowHi} = getNowInfo();

  const enseignants = useMemo(()=>{
    // Priorité Supabase, fallback DEMO_ACCOUNTS si pas de données
    const users = Object.values(data?.users||{}).filter(u=>u.role!=="animatrice");
    const source = users.length > 0 ? users
      : DEMO_ACCOUNTS.filter(a=>a.role==="enseignant");
    return source.map(u=>({...u, col:getColor(u.id), ini:getIni(u.nom)}))
      .filter(u => EDT_REEL[u.id]); // seulement ceux dans EDT_REEL
  }, [data]);

  useEffect(()=>{
    if (enseignants.length > 0 && !selEns) setSelEns(enseignants[0].id);
  },[enseignants]);

  // Charger les données statiques dès le démarrage de l'app
  useEffect(()=>{ 
    loadStaticData().then(()=>setStaticLoaded(true)); 
  },[]);

  useEffect(()=>{
    const allCl = [...new Set(
      enseignants.flatMap(e => Object.values(edtRt[e.id]||{}).flat().filter(Boolean))
    )].sort();
    if (allCl.length > 0 && !selCl) setSelCl(allCl[0]);
  },[enseignants, edtRt]);

  if (!data) return (
    <div style={{padding:"60px",textAlign:"center",color:C.txtMuted}}>
      <Spinner size={28} color={C.green}/>
      <div style={{marginTop:12,fontSize:13}}>Chargement…</div>
    </div>
  );

  // ── Modifier un créneau EDT ──────────────────────────────────────────
  const modifierCreneau = useCallback(async(ensId, jk, hi, nouvelleValeur) => {
    setSaving(true);
    const slot = `${jk}-${hi}`;
    const valeur = nouvelleValeur?.trim() || null;

    // 1. Mettre à jour edtRuntime localement → vues EDT se rafraîchissent immédiatement
    setEdtRt(prev => {
      const next = { ...prev };
      if (!next[ensId]) next[ensId] = {};
      if (!next[ensId][jk]) next[ensId][jk] = [];
      const newJour = [...(next[ensId][jk] || [])];
      newJour[hi] = valeur;
      next[ensId] = { ...next[ensId], [jk]: newJour };
      return next;
    });

    // 2. Recalculer les classes depuis le NOUVEL EDT (pas depuis edtRt qui n'est pas encore mis à jour)
    // On construit explicitement le nouvel EDT pour cet enseignant
    const currentEdt = edtRt[ensId] || {};
    const updatedEdt = {};
    Object.keys(currentEdt).forEach(k => { updatedEdt[k] = [...(currentEdt[k]||[])]; });
    if (!updatedEdt[jk]) updatedEdt[jk] = [];
    updatedEdt[jk] = [...(updatedEdt[jk]||[])];
    updatedEdt[jk][hi] = valeur;

    const newClasses = [...new Set(
      Object.values(updatedEdt).flat().filter(Boolean)
    )].sort();

    // 3. Mettre à jour data?.users||{} → ENS_CLASSES_REF virtuel
    setData(prev => ({
      ...prev,
      users: {
        ...prev.users,
        [ensId]: { ...(prev.users[ensId]||{}), classes: newClasses }
      },
      exceptions: {
        ...prev.exceptions,
        [ensId]: { ...(prev.exceptions?.[ensId]||{}), [slot]: valeur }
      }
    }));

    // 4. Si c'est l'enseignant connecté → mettre à jour user.classes aussi
    if (user?.id === ensId) {
      setUser(prev => ({ ...prev, classes: newClasses }));
    }

    // 5. Sauvegarder dans Supabase (edt_exceptions)
    const ok1 = valeur
      ? await sb.upsert("edt_exceptions", { ens_id:ensId, slot, lbl:valeur }, "ens_id,slot")
      : await sb.del("edt_exceptions", `?ens_id=eq.${ensId}&slot=eq.${slot}`);

    // 6. Sauvegarder classes dans Supabase (utilisateurs)
    const ok2 = await sb.upsert("utilisateurs", { id:ensId, classes:newClasses }, "id");

    setSaving(false);
    setModal(null);

    if (ok1 && ok2) {
      showToast(`✓ EDT mis à jour — ${newClasses.length} classes pour ${data?.users||{}[ensId]?.nom||ensId}`);
    } else {
      showToast("⚠ Erreur de sauvegarde Supabase", false);
    }
  }, [edtRt, data, user, setData, setUser, showToast]);

  // ── Toutes les classes dans l'EDT runtime ────────────────────────────
  const toutesClasses = useMemo(()=>[...new Set(
    enseignants.flatMap(e => Object.values(edtRt[e.id]||{}).flat().filter(Boolean))
  )].sort(), [enseignants, edtRt]);

  return (
    <div style={{display:"flex", flexDirection:"column", flex:1}}>

      {/* ── Onglets ────────────────────────────────────────────────── */}
      <div style={{background:C.white, borderBottom:`1px solid ${C.border}`, padding:"0 20px", display:"flex", gap:4, flexShrink:0, alignItems:"flex-end"}}>
        {[
          {id:"maintenant", label:"🕐 Maintenant",    sub:"Qui est où ?"},
          {id:"par-ens",    label:"👨‍🏫 Par enseignant", sub:"EDT + modification"},
          {id:"par-classe", label:"🎓 Par classe",     sub:"Qui enseigne ?"},
        ].map(o=>(
          <button key={o.id} onClick={()=>setOnglet(o.id)}
            style={{padding:"12px 16px", border:"none", borderBottom:`3px solid ${onglet===o.id?C.green:"transparent"}`, background:"transparent", cursor:"pointer", fontFamily:"inherit", textAlign:"left", transition:"all .15s"}}>
            <div style={{fontSize:12, fontWeight:700, color:onglet===o.id?C.green:C.txt}}>{o.label}</div>
            <div style={{fontSize:10, color:C.txtMuted, marginTop:1}}>{o.sub}</div>
          </button>
        ))}
        {saving && <div style={{marginLeft:"auto", display:"flex", alignItems:"center", gap:6, fontSize:12, color:C.blue, fontWeight:600, paddingBottom:8}}>
          <Spinner size={14} color={C.blue}/> Sauvegarde…
        </div>}
      </div>

      {/* ══ ONGLET 1 : MAINTENANT ══════════════════════════════════ */}
      {onglet==="maintenant" && (
        <div style={{flex:1, overflowY:"auto", padding:20, display:"flex", flexDirection:"column", gap:14}}>

          <div style={{background:`linear-gradient(135deg,${C.greenDark},${C.green})`, borderRadius:12, padding:"14px 18px", display:"flex", justifyContent:"space-between", alignItems:"center", color:"#fff"}}>
            <div>
              <div style={{fontSize:13, fontWeight:800}}>Vue temps réel — Emplois du temps SVTEEHB</div>
              <div style={{fontSize:11, opacity:.7, marginTop:2}}>
                {new Date().toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long"})}
                {nowJk && nowHi >= 0 ? ` · Créneau ${nowHi+1} — ${HEURES[nowHi]||""} en cours` : " · Hors des heures de cours"}
              </div>
            </div>
            <div style={{fontSize:26, fontWeight:900}}>
              {new Date().toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"})}
            </div>
          </div>

          {/* En cours maintenant */}
          {nowJk && nowHi >= 0 && (
            <div style={{background:C.white, borderRadius:12, border:`2px solid ${C.green}`, padding:16}}>
              <div style={{fontSize:12, fontWeight:800, color:C.green, marginBottom:10}}>🟢 En cours maintenant</div>
              <div style={{display:"flex", flexWrap:"wrap", gap:10}}>
                {enseignants.map(ens => {
                  const cl = edtRt[ens.id]?.[nowJk]?.[nowHi];
                  if (!cl) return null;
                  return (
                    <div key={ens.id} style={{display:"flex", alignItems:"center", gap:10, padding:"10px 14px", borderRadius:10, background:C.greenPale, border:`1px solid ${C.greenBorder}`}}>
                      <div style={{width:34, height:34, borderRadius:"50%", background:ens.col, display:"flex", alignItems:"center", justifyContent:"center", fontSize:11, fontWeight:800, color:"#fff"}}>{ens.ini}</div>
                      <div>
                        <div style={{fontSize:12, fontWeight:700, color:C.txt}}>{ens.nom}</div>
                        <div style={{fontSize:11, color:C.green, fontWeight:600}}>📍 {cl}</div>
                      </div>
                    </div>
                  );
                })}
                {!enseignants.some(e=>edtRt[e.id]?.[nowJk]?.[nowHi]) && (
                  <div style={{color:C.txtLight, fontSize:13}}>Aucun cours SVTEEHB en ce moment</div>
                )}
              </div>
            </div>
          )}

          {/* Grille globale */}
          <div style={{background:C.white, borderRadius:12, border:`1px solid ${C.border}`, overflow:"auto"}}>
            <div style={{padding:"12px 16px", borderBottom:`1px solid ${C.border}`, fontSize:12, fontWeight:700, color:C.txt}}>
              📅 Grille hebdomadaire — cliquez sur une cellule pour modifier
            </div>
            <div style={{overflowX:"auto"}}>
              <table style={{width:"100%", borderCollapse:"collapse", fontSize:11, minWidth:640}}>
                <thead>
                  <tr style={{background:"#0f1f14"}}>
                    <th style={{padding:"10px 12px", textAlign:"left", color:"rgba(255,255,255,.4)", fontSize:10, width:80}}>Heure</th>
                    {JOURS.map((j,ji)=>(
                      <th key={j} style={{padding:"10px 8px", textAlign:"center", color:nowJk===JKEYS[ji]?"#4ade80":"#fff", fontSize:11, fontWeight:nowJk===JKEYS[ji]?800:600}}>
                        {j}{nowJk===JKEYS[ji]&&<div style={{fontSize:8,color:"#4ade80",marginTop:1}}>Auj.</div>}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {HEURES.map((h,hi)=>(
                    <tr key={hi} style={{borderBottom:`1px solid ${C.border}`}}>
                      <td style={{padding:"6px 12px", fontSize:10, color:C.txtMuted, fontWeight:600, background:"#fafafa"}}>{h}</td>
                      {JKEYS.map((jk)=>{
                        const isNow = jk===nowJk&&hi===nowHi;
                        const occupants = enseignants.filter(e=>edtRt[e.id]?.[jk]?.[hi]);
                        return (
                          <td key={jk} style={{padding:3, verticalAlign:"top", background:isNow?"rgba(22,163,74,.04)":"transparent", minWidth:110}}>
                            {occupants.map(ens=>{
                              const cl = edtRt[ens.id]?.[jk]?.[hi];
                              return (
                                <div key={ens.id}
                                  style={{marginBottom:2, padding:"4px 7px", borderRadius:6, background:isNow?C.green:ens.col+"18", border:isNow?`1.5px solid ${C.green}`:`1px solid ${ens.col}30`, cursor:"pointer", position:"relative"}}
                                  onClick={()=>setModal({ensId:ens.id, jk, hi, valActuelle:cl, ensNom:ens.nom})}
                                  title={`Modifier — ${ens.nom}`}>
                                  <div style={{fontSize:9, fontWeight:700, color:isNow?"#fff":ens.col}}>{ens.ini}</div>
                                  <div style={{fontSize:9, color:isNow?"rgba(255,255,255,.8)":C.txtMuted, overflow:"hidden", textOverflow:"ellipsis", maxWidth:100}}>{cl}</div>
                                  <div style={{position:"absolute", top:2, right:3, fontSize:8, color:isNow?"rgba(255,255,255,.5)":C.txtLight}}>✎</div>
                                </div>
                              );
                            })}
                            {/* Cellule vide — ajouter un cours */}
                            {occupants.length === 0 && (
                              <div style={{height:32, borderRadius:6, border:`1px dashed ${C.border}`, cursor:"pointer", display:"flex", alignItems:"center", justifyContent:"center"}}
                                onClick={()=>{
                                  // Demander quel enseignant assigner
                                  const ensId = selEns || enseignants[0]?.id;
                                  if(ensId) setModal({ensId, jk, hi, valActuelle:null, ensNom:enseignants.find(e=>e.id===ensId)?.nom||""});
                                }}>
                                <span style={{fontSize:10, color:C.txtLight}}>+</span>
                              </div>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* ══ ONGLET 2 : PAR ENSEIGNANT (avec modification) ══════════ */}
      {onglet==="par-ens" && (
        <div style={{display:"flex", flex:1, minHeight:0, overflow:"hidden"}}>
          <aside style={{width:160, minWidth:160, background:C.sidebar, overflowY:"auto", scrollbarWidth:"none", paddingBottom:16}}>
            <div style={{padding:"10px 12px 6px", fontSize:9, fontWeight:800, color:"rgba(255,255,255,.35)", textTransform:"uppercase", letterSpacing:".1em"}}>Enseignants</div>
            {enseignants.map(ens=>{
              const coursActuel = nowJk&&nowHi>=0 ? edtRt[ens.id]?.[nowJk]?.[nowHi] : null;
              const isA = ens.id===selEns;
              return (
                <div key={ens.id} onClick={()=>setSelEns(ens.id)}
                  style={{padding:"9px 12px", cursor:"pointer", background:isA?"rgba(34,197,94,.15)":"transparent"}}
                  onMouseEnter={e=>{if(!isA)e.currentTarget.style.background="rgba(255,255,255,.06)";}}
                  onMouseLeave={e=>{if(!isA)e.currentTarget.style.background="transparent";}}>
                  <div style={{display:"flex", alignItems:"center", gap:8}}>
                    <div style={{width:28, height:28, borderRadius:"50%", background:ens.col, display:"flex", alignItems:"center", justifyContent:"center", fontSize:9, fontWeight:800, color:"#fff", flexShrink:0, position:"relative"}}>
                      {ens.ini}
                      {coursActuel&&<div style={{position:"absolute",top:-2,right:-2,width:8,height:8,borderRadius:"50%",background:"#4ade80",border:"1.5px solid #0f1f14"}}/>}
                    </div>
                    <div style={{overflow:"hidden"}}>
                      <div style={{fontSize:11, fontWeight:isA?700:400, color:isA?"#4ade80":"rgba(255,255,255,.6)", whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis"}}>{ens.nom.split(" ")[0]}</div>
                      <div style={{fontSize:9,color:"rgba(255,255,255,.4)",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{ens.nom.split(" ").slice(1).join(" ")}</div>
                      {coursActuel&&<div style={{fontSize:9,color:"#4ade80",fontWeight:600}}>🟢 {coursActuel}</div>}
                    </div>
                  </div>
                </div>
              );
            })}
          </aside>

          <main style={{flex:1, overflowY:"auto", padding:20}}>
            {selEns && (()=>{
              const ens = enseignants.find(e=>e.id===selEns);
              if (!ens) return null;
              const edt = edtRt[ens.id]||{};
              const coursActuel = nowJk&&nowHi>=0 ? edt[nowJk]?.[nowHi] : null;
              const classesEns = getClassesFromEdt(ens.id, edtRt);
              return (
                <div style={{display:"flex", flexDirection:"column", gap:14}}>
                  <div style={{background:C.white, borderRadius:12, border:`1px solid ${C.border}`, padding:"16px 18px", display:"flex", alignItems:"center", gap:14}}>
                    <div style={{width:46, height:46, borderRadius:"50%", background:ens.col, display:"flex", alignItems:"center", justifyContent:"center", fontSize:15, fontWeight:800, color:"#fff"}}>{ens.ini}</div>
                    <div style={{flex:1}}>
                      <div style={{fontSize:16, fontWeight:800, color:C.txt}}>{ens.nom}</div>
                      <div style={{fontSize:11, color:C.txtMuted, marginTop:2}}>
                        {classesEns.length} classe{classesEns.length>1?"s":""}
                        {coursActuel&&<span style={{color:C.green,fontWeight:700,marginLeft:10}}>🟢 {coursActuel}</span>}
                      </div>
                    </div>
                    <Pill ch="✎ Cliquer sur un créneau pour modifier" color={C.blue}/>
                  </div>

                  {/* Grille EDT modifiable */}
                  <div style={{background:C.white, borderRadius:12, border:`1px solid ${C.border}`, overflow:"auto"}}>
                    <table style={{width:"100%", borderCollapse:"collapse", fontSize:11, minWidth:520}}>
                      <thead>
                        <tr style={{background:"#0f1f14"}}>
                          <th style={{padding:"9px 12px", textAlign:"left", color:"rgba(255,255,255,.4)", fontSize:10, width:80}}>Heure</th>
                          {JOURS.map((j,ji)=>(
                            <th key={j} style={{padding:"9px 8px", textAlign:"center", color:nowJk===JKEYS[ji]?"#4ade80":"#fff", fontSize:11, fontWeight:nowJk===JKEYS[ji]?800:600}}>{j}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {HEURES.map((h,hi)=>(
                          <tr key={hi} style={{borderBottom:`1px solid ${C.border}`}}>
                            <td style={{padding:"8px 12px", fontSize:10, color:C.txtMuted, fontWeight:600, background:"#fafafa"}}>{h}</td>
                            {JKEYS.map(jk=>{
                              const cl = edt[jk]?.[hi];
                              const isNow = jk===nowJk&&hi===nowHi;
                              return (
                                <td key={jk} style={{padding:4, verticalAlign:"top", background:isNow?"rgba(22,163,74,.05)":"transparent", cursor:"pointer"}}
                                  onClick={()=>setModal({ensId:ens.id, jk, hi, valActuelle:cl||null, ensNom:ens.nom})}>
                                  {cl ? (
                                    <div style={{padding:"7px 9px", borderRadius:8, background:isNow?C.green:ens.col+"18", color:isNow?"#fff":ens.col, border:isNow?`2px solid ${C.green}`:`1px solid ${ens.col}30`, fontSize:11, fontWeight:700, display:"flex", justifyContent:"space-between", alignItems:"center"}}>
                                      <span>{cl}</span>
                                      <span style={{fontSize:10, opacity:.6}}>✎</span>
                                    </div>
                                  ) : (
                                    <div style={{height:36, borderRadius:8, border:`1px dashed ${C.border}`, display:"flex", alignItems:"center", justifyContent:"center"}}>
                                      <span style={{fontSize:11, color:C.txtLight}}>+</span>
                                    </div>
                                  )}
                                </td>
                              );
                            })}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  {/* Classes résultantes */}
                  <div style={{background:C.white, borderRadius:11, border:`1px solid ${C.border}`, padding:"14px 16px"}}>
                    <div style={{fontSize:12, fontWeight:700, color:C.txt, marginBottom:10}}>📚 Classes calculées depuis l'EDT</div>
                    <div style={{display:"flex", flexWrap:"wrap", gap:8}}>
                      {classesEns.length > 0
                        ? classesEns.map(cl=>(
                            <div key={cl} style={{padding:"5px 12px", borderRadius:20, background:ens.col+"15", border:`1px solid ${ens.col}30`, color:ens.col, fontSize:12, fontWeight:700}}>{cl}</div>
                          ))
                        : <span style={{color:C.txtLight, fontSize:12}}>Aucune classe dans l'EDT</span>
                      }
                    </div>
                  </div>
                </div>
              );
            })()}
          </main>
        </div>
      )}

      {/* ══ ONGLET 3 : PAR CLASSE ══════════════════════════════════ */}
      {onglet==="par-classe" && (
        <div style={{display:"flex", flex:1, minHeight:0, overflow:"hidden"}}>
          <aside style={{width:160, minWidth:160, background:C.sidebar, overflowY:"auto", scrollbarWidth:"none", paddingBottom:16}}>
            <div style={{padding:"10px 12px 6px", fontSize:9, fontWeight:800, color:"rgba(255,255,255,.35)", textTransform:"uppercase", letterSpacing:".1em"}}>Classes ({toutesClasses.length})</div>
            {toutesClasses.map(cl=>{
              const isA = cl===selCl;
              const ensActuel = nowJk&&nowHi>=0 ? enseignants.find(e=>edtRt[e.id]?.[nowJk]?.[nowHi]===cl) : null;
              return (
                <div key={cl} onClick={()=>setSelCl(cl)}
                  style={{padding:"8px 12px", cursor:"pointer", background:isA?"rgba(34,197,94,.15)":"transparent"}}
                  onMouseEnter={e=>{if(!isA)e.currentTarget.style.background="rgba(255,255,255,.06)";}}
                  onMouseLeave={e=>{if(!isA)e.currentTarget.style.background="transparent";}}>
                  <div style={{fontSize:11, fontWeight:isA?700:400, color:isA?"#4ade80":"rgba(255,255,255,.6)"}}>{cl}</div>
                  {ensActuel&&<div style={{fontSize:9,color:"#4ade80",marginTop:2}}>🟢 {ensActuel.ini}</div>}
                </div>
              );
            })}
          </aside>

          <main style={{flex:1, overflowY:"auto", padding:20}}>
            {selCl && (()=>{
              const ensClasse = enseignants.filter(e=>Object.values(edtRt[e.id]||{}).some(j=>j?.includes(selCl)));
              const ensActuel = nowJk&&nowHi>=0 ? enseignants.find(e=>edtRt[e.id]?.[nowJk]?.[nowHi]===selCl) : null;
              return (
                <div style={{display:"flex", flexDirection:"column", gap:14}}>
                  <div style={{background:C.white, borderRadius:12, border:`1px solid ${C.border}`, padding:"16px 18px"}}>
                    <div style={{fontSize:17, fontWeight:800, color:C.txt}}>{selCl}</div>
                    <div style={{fontSize:11, color:C.txtMuted, marginTop:3}}>
                      {(ELEVES_DB[selCl]||[]).length} élèves · {ensClasse.length} enseignant{ensClasse.length>1?"s":""} SVTEEHB
                    </div>
                    {ensActuel&&(
                      <div style={{marginTop:8,display:"inline-flex",alignItems:"center",gap:8,background:C.greenPale,border:`1px solid ${C.greenBorder}`,borderRadius:8,padding:"7px 12px"}}>
                        <div style={{width:24,height:24,borderRadius:"50%",background:ensActuel.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:9,fontWeight:800,color:"#fff"}}>{ensActuel.ini}</div>
                        <div style={{fontSize:12,fontWeight:700,color:C.green}}>🟢 {ensActuel.nom} en cours dans cette classe</div>
                      </div>
                    )}
                  </div>
                  {ensClasse.map(ens=>{
                    const creneaux=[];
                    JKEYS.forEach((jk,ji)=>HEURES.forEach((_,hi)=>{if(edtRt[ens.id]?.[jk]?.[hi]===selCl)creneaux.push({jk,ji,hi});}));
                    return (
                      <div key={ens.id} style={{background:C.white,borderRadius:11,border:`1px solid ${C.border}`,overflow:"hidden"}}>
                        <div style={{padding:"12px 16px",display:"flex",alignItems:"center",gap:12,borderBottom:`1px solid ${C.border}`,background:ens.col+"08"}}>
                          <div style={{width:36,height:36,borderRadius:"50%",background:ens.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:11,fontWeight:800,color:"#fff"}}>{ens.ini}</div>
                          <div>
                            <div style={{fontSize:13,fontWeight:700,color:C.txt}}>{ens.nom}</div>
                            <div style={{fontSize:11,color:C.txtMuted}}>{creneaux.length} créneau{creneaux.length>1?"x":""}/semaine</div>
                          </div>
                          <button onClick={()=>{setSelEns(ens.id);setOnglet("par-ens");}}
                            style={{marginLeft:"auto",padding:"5px 12px",background:C.greenPale,border:`1px solid ${C.greenBorder}`,borderRadius:8,fontSize:11,fontWeight:700,cursor:"pointer",color:C.green,fontFamily:"inherit"}}>
                            Voir son EDT →
                          </button>
                        </div>
                        <div style={{padding:"12px 16px",display:"flex",flexWrap:"wrap",gap:8}}>
                          {creneaux.map((cr,i)=>{
                            const isNow=cr.jk===nowJk&&cr.hi===nowHi;
                            return(
                              <div key={i} style={{padding:"6px 12px",borderRadius:8,background:isNow?C.green:C.greenPale,border:`1px solid ${isNow?C.green:C.greenBorder}`,fontSize:12,fontWeight:700,color:isNow?"#fff":C.green}}>
                                {JOURS[cr.ji]} · {HEURES[cr.hi]}{isNow&&" 🟢"}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              );
            })()}
          </main>
        </div>
      )}

      {/* ══ MODAL MODIFICATION CRÉNEAU ══════════════════════════════ */}
      {modal && (
        <ModalEdtModif
          modal={modal}
          enseignants={enseignants}
          onConfirm={modifierCreneau}
          onClose={()=>setModal(null)}
        />
      )}
    </div>
  );
}

// ── Modal de modification d'un créneau EDT ────────────────────────────
function ModalEdtModif({ modal, enseignants, onConfirm, onClose }) {
  const {ensId, jk, hi, valActuelle, ensNom} = modal;
  const [newVal, setNewVal]   = useState(valActuelle || "");
  const [newEns, setNewEns]   = useState(ensId);
  const inputRef = useRef(null);

  useEffect(()=>{ setTimeout(()=>inputRef.current?.focus(), 80); },[]);

  const jourNom  = JOURS[JKEYS.indexOf(jk)] || jk;
  const heureNom = HEURES[hi] || `Créneau ${hi+1}`;

  const handleConfirm = () => {
    onConfirm(newEns, jk, hi, newVal);
  };

  const handleSupprimer = () => {
    onConfirm(ensId, jk, hi, null);
  };

  return (
    <div style={{position:"fixed",inset:0,background:"rgba(0,0,0,.5)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:1000,animation:"fadeIn .2s"}}>
      <div style={{background:C.white,borderRadius:16,padding:"24px 28px",width:"100%",maxWidth:440,boxShadow:"0 24px 80px rgba(0,0,0,.25)"}}>
        <h3 style={{fontSize:15,fontWeight:800,color:C.txt,margin:"0 0 4px"}}>✎ Modifier un créneau</h3>
        <p style={{fontSize:12,color:C.txtMuted,margin:"0 0 18px"}}>
          {jourNom} · {heureNom} · <strong>{ensNom}</strong>
          {valActuelle && <> · Actuel : <strong>{valActuelle}</strong></>}
        </p>

        {/* Enseignant */}
        <div style={{marginBottom:14}}>
          <label style={{fontSize:11,fontWeight:700,color:C.txtMuted,display:"block",marginBottom:5,textTransform:"uppercase",letterSpacing:".06em"}}>Enseignant</label>
          <select value={newEns} onChange={e=>setNewEns(e.target.value)}
            style={{width:"100%",padding:"9px 12px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,background:"#f8fafc",fontFamily:"inherit"}}>
            {enseignants.map(e=>(
              <option key={e.id} value={e.id}>{e.nom}</option>
            ))}
          </select>
        </div>

        {/* Classe */}
        <div style={{marginBottom:20}}>
          <label style={{fontSize:11,fontWeight:700,color:C.txtMuted,display:"block",marginBottom:5,textTransform:"uppercase",letterSpacing:".06em"}}>
            Classe <span style={{color:C.txtLight,fontSize:10,fontWeight:400}}>(vide = supprimer le cours)</span>
          </label>
          <input
            ref={inputRef}
            value={newVal}
            onChange={e=>setNewVal(e.target.value.toUpperCase())}
            onKeyDown={e=>{ if(e.key==="Enter") handleConfirm(); if(e.key==="Escape") onClose(); }}
            placeholder="Ex : 5ème 2, 1ère D…"
            list="classes-list"
            style={{width:"100%",padding:"10px 14px",border:`1.5px solid ${C.border}`,borderRadius:9,fontSize:13,color:C.txt,background:"#f8fafc",fontFamily:"inherit"}}
            onFocus={e=>{e.target.style.borderColor=C.green;e.target.style.background=C.white;}}
            onBlur={e=>{e.target.style.borderColor=C.border;e.target.style.background="#f8fafc";}}/>
          <datalist id="classes-list">
            {Object.keys(ELEVES_DB).map(cl=><option key={cl} value={cl}/>)}
          </datalist>
        </div>

        {/* Boutons */}
        <div style={{display:"flex",gap:8}}>
          <button onClick={onClose}
            style={{flex:1,padding:"10px",borderRadius:9,border:`1px solid ${C.border}`,background:C.white,color:C.txtMuted,fontSize:13,fontWeight:700,cursor:"pointer",fontFamily:"inherit"}}>
            Annuler
          </button>
          {valActuelle && (
            <button onClick={handleSupprimer}
              style={{padding:"10px 14px",borderRadius:9,border:`1px solid ${C.red}30`,background:C.redPale,color:C.red,fontSize:13,fontWeight:700,cursor:"pointer",fontFamily:"inherit"}}>
              🗑 Supprimer
            </button>
          )}
          <button onClick={handleConfirm}
            style={{flex:2,padding:"10px",borderRadius:9,border:"none",background:`linear-gradient(135deg,${C.greenDark},${C.green})`,color:"#fff",fontSize:13,fontWeight:700,cursor:"pointer",fontFamily:"inherit"}}>
            ✓ Confirmer
          </button>
        </div>
      </div>
    </div>
  );
}


function DashboardAdmin() {
  const {data,user} = useApp();
  const [loading,setLoading] = useState(true);
  const [stats,setStats] = useState({nbEns:0,nbClasses:0,nbEleves:0,tauxMoyen:0,tauxParEns:[]});
  useEffect(()=>{
    if(!data)return;
    const rawEns = Object.values(data?.users||{}).filter(u=>u.role!=="animatrice");
  const rawHasClasses = rawEns.some(u=>(u.classes||[]).length>0);
  const ens = (rawEns.length > 0 && rawHasClasses) ? rawEns
    : DEMO_ACCOUNTS.filter(a=>a.role==="enseignant").map(a=>({
        ...a, col:getColor(a.id), ini:getIni(a.nom), classes: ENS_CLASSES_REF[a.id]||[]
      }));
    const nbEleves=(data.classes||[]).reduce((s,c)=>s+(c.effectif||0),0);
    const tauxParEns=ens.map(e=>{
      let tf=0,tr=0;
      (e.classes||[]).forEach(cl=>{const k=`${e.id}||${cl}`;const f=((data?.prog||{})[k]||[]).length;const code=resolveProgCode(cl);const meta=code?PROG_META[code]:null;if(meta){tf+=f;tr+=meta.lpRef;}});
      return{id:e.id,nom:e.nom,col:getColor(e.id),ini:getIni(e.nom),classes:(e.classes||[]).length,taux:tr>0?Math.round(tf/tr*100):0,tf,tr};
    }).sort((a,b)=>b.taux-a.taux);
    const tauxMoyen=tauxParEns.length?Math.round(tauxParEns.reduce((s,e)=>s+e.taux,0)/tauxParEns.length):0;
    setStats({nbEns:ens.length,nbClasses:(data.classes||[]).length,nbEleves,tauxMoyen,tauxParEns});
    setLoading(false);
  },[data]);
  const topCap=stats.tauxParEns.length>0?Math.max(...stats.tauxParEns.map(e=>e.taux),1):100;
  const tauCol=t=>t>=75?C.green:t>=50?C.amber:C.red;
  return(
    <div style={{padding:"20px 20px 40px",display:"flex",flexDirection:"column",gap:18}}>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
        <div><h2 style={{fontSize:20,fontWeight:800,color:C.txt,margin:0}}>Bonjour, Administration 👋</h2><p style={{color:C.txtMuted,margin:"3px 0 0",fontSize:12}}>{new Date().toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric"})}</p></div>
        <div style={{textAlign:"right"}}><div style={{fontSize:11,color:C.txtMuted}}>2025–2026</div><div style={{fontSize:13,fontWeight:700,color:C.green}}>Données en direct ↗</div></div>
      </div>
      <div style={{display:"flex",gap:10,flexWrap:"wrap"}}>
        <KpiCard label="Enseignants" value={stats.nbEns} sub="SVTEEHB Kakatare" iconEmoji="👥" bg={C.greenPale} loading={loading} delay={0}/>
        <KpiCard label="Classes" value={stats.nbClasses} sub="Toutes séries" iconEmoji="📚" bg={C.bluePale} subColor={C.blue} loading={loading} delay={0.05}/>
        <KpiCard label="Élèves" value={stats.nbEleves} sub="Total effectifs" iconEmoji="🎓" bg={C.amberPale} subColor={C.amber} loading={loading} delay={0.1}/>
        <KpiCard label="Couverture" value={`${stats.tauxMoyen}%`} sub={stats.tauxMoyen>=75?"✓ Objectif atteint":"⚠ Sous objectif"} subColor={tauCol(stats.tauxMoyen)} iconEmoji="📊" bg={C.greenPale} loading={loading} delay={0.15}/>
      </div>
      <div style={{background:C.white,borderRadius:12,border:`1px solid ${C.border}`,padding:18}}>
        <h3 style={{margin:"0 0 14px",fontSize:13,fontWeight:700,color:C.txt}}>📊 Couverture programme — tous les enseignants</h3>
        {loading?[1,2,3,4,5].map(i=><Sk key={i} h={52} br={8} style={{marginBottom:8}}/>):(
          <div style={{display:"flex",flexDirection:"column",gap:8}}>
            {stats.tauxParEns.map((e,i)=>(
              <div key={e.id} style={{display:"flex",alignItems:"center",gap:12,padding:"10px 12px",background:i===0?C.greenPale+"80":"#f8fafc",borderRadius:9,border:`1px solid ${i===0?C.greenBorder:C.border}`}}>
                <div style={{width:20,textAlign:"center",fontSize:12,fontWeight:800,color:i<3?[C.green,C.amber,C.orange][i]:C.txtLight}}>#{i+1}</div>
                <div style={{width:32,height:32,borderRadius:"50%",background:e.col,display:"flex",alignItems:"center",justifyContent:"center",fontSize:10,fontWeight:800,color:"#fff",flexShrink:0}}>{e.ini}</div>
                <div style={{flex:1,minWidth:0}}><div style={{fontSize:12,fontWeight:700,color:C.txt,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"}}>{e.nom}</div><div style={{fontSize:10,color:C.txtMuted}}>{e.classes} classe{e.classes>1?"s":""} · {e.tf}/{e.tr} leçons</div></div>
                <div style={{width:140,flexShrink:0}}>
                  <div style={{display:"flex",justifyContent:"space-between",marginBottom:3}}><span style={{fontSize:10,color:C.txtMuted}}>Couverture</span><span style={{fontSize:11,fontWeight:800,color:tauCol(e.taux)}}>{e.taux}%</span></div>
                  <ProgBar value={e.taux}/>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

