let _elevesLoaded = false;

async function loadElevesDB() {
  if(_elevesLoaded) return;
  try {
    const r = await fetch('/data/eleves.json');
    if(r.ok){ Object.assign(ELEVES_DB, await r.json()); _elevesLoaded=true; }
  } catch(e){ console.warn('ELEVES_DB: fetch échoué', e); }
}

// LECONS_DATA est désormais dans le bundle — chargement direct
async function loadStaticData() {
  await loadElevesDB(); // Seul ELEVES_DB est chargé dynamiquement
}

